#!/usr/bin/env python3
"""kabu: notify a human and ask them through the Kabu app, from any script or coding agent.

Commands:
  kabu send [TITLE] MESSAGE     notify; `kabu "message"` with no command does the same
  kabu ask QUESTION [MESSAGE]   ask and wait for the answer; `kabu --ask "Q?"` does the same
  kabu status MSG_ID            a message as the API has it (--wait N holds while an ask is pending)
  kabu whoami                   what the key can do, and the project and agent kabu would send
  kabu session start|update|end a session and its Live Activity (--headline, --progress N/M when measured)
  kabu login                    save --api-key KEY, or connect this computer with --device
  kabu mcp                      Kabu's MCP tools on stdin and stdout, for an agent harness to start
  kabu guide                    a copy-paste cheat sheet for coding agents (also: kabu help agents)
  kabu help COMMAND             one command's options and examples (same as kabu COMMAND --help)

Presence (on by default; KABU_PRESENCE=0 or kabu presence off turns it off): kabu presence status shows whether your
agents are live, as their hooks wrote it on this machine and one kabu presence run reports it; kabu presence install
--harness claude|copilot adds the hook to a harness's settings (the Kabu plugin has it), and uninstall takes it out.

Output is one JSON object on stdout. An error is one JSON line on stderr, {"error": {"code", "message", "hint"}};
the hint is the next step, usually a corrected command. Nothing is ever coloured.
Exit codes: 0 ok (an ask approved, or a choice or text answered), 2 usage or validation error (nothing was sent),
3 network or API error, or an answer kabu does not know, 10 rejected, 20 expired, 21 cancelled or deleted, 130 interrupted.
Environment: KABU_API_KEY, KABU_BASE_URL (default https://usekabu.com), KABU_PROJECT, KABU_AGENT, KABU_SOURCE,
KABU_SESSION, KABU_AUTO_SESSION=1 (one session per host, project and agent), KABU_CONFIG_PATH (default
~/.config/kabu/config.json, written by kabu login, mode 600), KABU_PRESENCE=0 (presence off), KABU_HOME (default
~/.kabu: presence's reporter identity), KABU_RUNTIME_DIR (default XDG_RUNTIME_DIR or TMPDIR: presence's records).
"""
from __future__ import annotations

import argparse
import calendar
from dataclasses import dataclass, field
import difflib
import functools
import getpass
import hashlib
import hmac
import http.client
import json
import mimetypes
import os
from pathlib import Path
import re
import shlex
import socket
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid
from typing import Any, Callable, Dict, Iterable, List, Mapping, NamedTuple, NoReturn, Optional, Sequence, Set, Tuple

VERSION = "2.5.0"
EXIT_OK, EXIT_USAGE, EXIT_TRANSPORT = 0, 2, 3
EXIT_REJECTED, EXIT_EXPIRED, EXIT_CANCELLED = 10, 20, 21  # an ask's outcomes; login --device: denied, expired
DEFAULT_BASE_URL = "https://usekabu.com"
WAIT = 25  # seconds the API may hold one request for a pending ask (the contract allows 0 to 50)
GRACE = 120  # seconds kabu keeps waiting past an ask's expiry, for the API to settle it
RETRIES = 3  # after the first try: network errors, 5xx, 429 with Retry-After, 409 idempotency_key_in_use
MAX_RETRY_AFTER = 30.0  # a longer Retry-After fails now rather than block the caller
TITLE_MAX, BODY_MAX = 120, 8192  # MessageCreate maxLength, in characters
REQUEST_MAX = 64 << 10  # the API's cap on a JSON request, in bytes
JSON = Dict[str, Any]
# The type an upload declares, by extension: the container types players open first (AVFoundation will not open
# audio/mp4a-latm, the codec Python's mimetypes names .m4a on macOS; .aac is raw ADTS, audio/aac), then mimetypes.
UPLOAD_TYPES = {
    "m4a": "audio/mp4", "m4b": "audio/mp4", "aac": "audio/aac", "mp4": "video/mp4", "m4v": "video/mp4",
    "mp3": "audio/mpeg", "wav": "audio/wav", "ogg": "audio/ogg", "oga": "audio/ogg", "opus": "audio/ogg",
    "webm": "video/webm", "mov": "video/quicktime", "png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg",
    "gif": "image/gif", "heic": "image/heic", "pdf": "application/pdf", "md": "text/markdown", "txt": "text/plain",
    "json": "application/json", "csv": "text/csv",
}


@dataclass
class CliError(Exception):
    """A failure, printed as one JSON line on stderr: {"error": {"code", "message", "hint", ...extra}}."""

    code: str
    message: str
    hint: str
    exit: int = EXIT_USAGE
    extra: JSON = field(default_factory=dict)


def error_line(e: CliError) -> str:
    """The one JSON line an error prints on stderr. No key ever shows in it: kabu_live_sk_… keeps only its prefix."""
    line = json.dumps({"error": {"code": e.code, "message": e.message, "hint": e.hint, **e.extra}})
    return re.sub(r"kabu_(live|test)_sk_\w+", r"kabu_\1_sk_***", line)


def emit(obj: JSON, code: int = EXIT_OK, sort: bool = False) -> int:
    """Print a command's one JSON object, and return its exit code."""
    print(json.dumps(obj, sort_keys=sort))
    return code


def utf8_json(obj: JSON) -> bytes:
    """A request body as UTF-8 JSON: \\u escapes cost up to 12 bytes a character against the API's 64 KiB cap."""
    return json.dumps(obj, ensure_ascii=False).encode("utf-8", "replace")  # replace: a lone surrogate from argv


def default_config_path() -> Path:
    if os.environ.get("KABU_CONFIG_PATH"):
        return Path(os.environ["KABU_CONFIG_PATH"])
    return Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "kabu" / "config.json"


def load_config() -> JSON:
    try:
        data = json.loads(default_config_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def save_config(cfg: JSON) -> Path:
    """Write the config with mode 600 from the first byte: the key never sits in a readable file."""
    path = default_config_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    with os.fdopen(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as out:
        out.write(json.dumps(cfg, indent=2, sort_keys=True) + "\n")
    os.chmod(tmp, 0o600)
    os.replace(tmp, path)
    return path


def resolve_setting(flag: Optional[str], env_keys: Sequence[str], cfg: JSON, cfg_key: str, default: str = "") -> str:
    """The flag, else the first environment variable set, else the saved setting, else the default."""
    for candidate in (flag, *(os.environ.get(k) for k in env_keys), cfg.get(cfg_key)):
        if isinstance(candidate, str) and candidate:
            return candidate
    return default


def base_url(flag: Optional[str], cfg: JSON) -> str:
    url = resolve_setting(flag, ("KABU_BASE_URL", "KABU_API_BASE_URL"), cfg, "base_url", DEFAULT_BASE_URL).rstrip("/")
    if not re.fullmatch(r"https?://[^/\s]+(/\S*)?", url):
        raise CliError("invalid_value", f"The base URL {url!r} is not an http:// or https:// URL.", "Fix --base-url, KABU_BASE_URL "
                       "or the saved one, with: kabu login --base-url https://usekabu.com")
    return url[:-3] if url.endswith("/v2") else url


PROJECT_ENV_KEYS = ("KABU_PROJECT", "AGENT_NOTIFIER_PROJECT")
TEMP_DIRS = tuple({Path(d).resolve() for d in ("/tmp", "/var/tmp", "/var/folders", os.environ.get("TMPDIR") or "/tmp")})
KEPT_DAYS = 7  # an agent session's kept project is removed once unused this long
PROC = Path("/proc")  # Linux's process files


def _git(cwd: Path, *args: str) -> str:
    try:
        out = subprocess.run(["git", *args], cwd=str(cwd), capture_output=True, text=True, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.stdout.strip() if out.returncode == 0 else ""


def _read_dotenv_project(path: Path) -> str:
    """KABU_PROJECT, else AGENT_NOTIFIER_PROJECT, from one .env file (export, quotes and trailing comments allowed)."""
    try:
        lines = path.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return ""
    found: Dict[str, str] = {}
    for raw in lines:
        line = raw.strip()
        key, sep, val = (line[7:].lstrip() if line.startswith("export ") else line).partition("=")
        key, val = key.strip(), val.strip()
        if line.startswith("#") or not sep or key not in PROJECT_ENV_KEYS:
            continue
        if val[:1] in ("'", '"'):
            end = val.find(val[0], 1)
            val = val[1:end] if end > 0 else val[1:]
        else:
            val = val.split(" #", 1)[0].strip()
        if val:
            found[key] = val
    return next((found[k] for k in PROJECT_ENV_KEYS if found.get(k)), "")


def _git_roots(cwd: Path) -> Tuple[Optional[Path], Optional[Path]]:
    """Return (this worktree's top level, the main worktree's top level)."""
    top = _git(cwd, "rev-parse", "--show-toplevel")
    if not top:
        return None, None
    common = _git(cwd, "rev-parse", "--path-format=absolute", "--git-common-dir")
    main = Path(common).parent if common and Path(common).name == ".git" else Path(top)
    return Path(top).resolve(), main.resolve()


def is_temp(folder: Path) -> bool:
    """A temp folder, or one inside it: it never names a project."""
    return any(folder == d or d in folder.parents for d in TEMP_DIRS)


def named_project(folder: Path) -> Tuple[str, str]:
    """The project a folder names, and how: KABU_PROJECT in .env.local or .env from the folder up to its repository's top,
    then the main worktree's ("dotenv"); else the git repository's name ("git"). ("", "") when it names none, as a temp
    folder does unless it is a worktree of a repository whose main worktree is outside the temp folders."""
    top, main = _git_roots(folder)
    if is_temp(folder) and (main is None or is_temp(main)):
        return "", ""
    dirs = [folder]  # from here up to the repository's top, then the main worktree's
    while top is not None and dirs[-1] != top and dirs[-1].parent != dirs[-1]:
        dirs.append(dirs[-1].parent)
    if main is not None and main not in dirs:
        dirs.append(main)
    for d in dirs:
        for name in (".env.local", ".env"):
            found = _read_dotenv_project(d / name)
            if found:
                return found, "dotenv"
    if main is None:
        return "", ""
    name = _git(folder, "config", "--get", "remote.origin.url").rstrip("/").rsplit("/", 1)[-1].rsplit(":", 1)[-1]
    return (name[:-4] if name.endswith(".git") else name) or main.name, "git"


def resolve_project(cwd: Optional[Path] = None) -> Tuple[Optional[str], JSON]:
    """The project to send without --project (None: the API picks), and the rule that named it (CONTRACT.md, Project
    resolution): the environment, the agent session's root, what the session kept, this folder, the login, a name."""
    for k in PROJECT_ENV_KEYS:
        if os.environ.get(k, "").strip():
            return os.environ[k].strip(), {"rule": "env", "variable": k}
    agent = harness()
    seen: JSON = {"harness": agent[2]} if agent else {}
    variable = {"variable": "CLAUDE_PROJECT_DIR"} if os.environ.get("CLAUDE_PROJECT_DIR") else {}
    found = Path(os.environ["CLAUDE_PROJECT_DIR"]) if variable else process_cwd(agent[0]) if agent else None
    root = str(found.resolve()) if found else ""
    kept = cache_dir() / "sessions" / f"{session_key(agent)}.json" if session_key(agent) else None
    if kept is not None:
        try:
            entry = json.loads(kept.read_text(encoding="utf-8"))
            if entry["root"] == root:  # read back while the root is the folder it was named under; moved, resolve again
                kept.touch()  # in use: kept for another KEPT_DAYS
                return str(entry["project"]), {**entry["source"], "cached": True}
        except (OSError, ValueError, KeyError, TypeError):
            pass  # not kept yet, or unreadable: resolve again
    folders = [("session_root", Path(root))] if root else []
    try:
        folders.append(("cwd", (cwd or Path.cwd()).resolve()))
    except OSError:
        pass  # the current folder was removed: it names nothing, and the root may still
    for rule, folder in folders:
        name, via = named_project(folder)
        if name:
            source = {"rule": rule, **seen, "dir": str(folder), "via": via, **(variable if rule == "session_root" else {})}
            if kept is not None:  # for the session's later calls; files no session used for KEPT_DAYS go
                write_cache(kept, json.dumps({"project": name, "source": source, "root": root}), time.time() - KEPT_DAYS * 86400)
            return name, source
    saved = load_config().get("project")
    if isinstance(saved, str) and saved.strip():
        return saved.strip(), {"rule": "login", **seen}
    home, host = Path(os.path.expanduser("~")).resolve(), socket.gethostname().split(".", 1)[0] or "host"
    for rule, folder in folders:  # never a name for /, the home folder, a missing folder (Linux: "… (deleted)") or a temp one
        if folder.parent != folder and folder != home and folder.is_dir() and not is_temp(folder):
            return f"{folder.name}@{host}", {"rule": "folder", **seen, "dir": str(folder)}
    return None, {"rule": "default", **seen}


def harness() -> Optional[Tuple[int, str, str]]:
    """The agent session kabu runs in: its harness, the nearest ancestor named as one (process id, start time, name)."""
    return next((p for p in ancestors() if p[2] in AGENT_PROCESSES), None)


def session_key(agent: Optional[Tuple[int, str, str]]) -> str:
    """An agent session's key: its harness's process id and a hash of its start time, so a reused id never matches;
    "" when there is no harness or its start time is unknown."""
    return f"{agent[0]}-{hashlib.sha256(agent[1].encode()).hexdigest()[:16]}" if agent and agent[1] else ""


def cache_dir() -> Path:
    return Path(os.environ.get("XDG_CACHE_HOME") or Path.home() / ".cache") / "kabu"


def write_cache(path: Path, text: str, stale: float = 0) -> None:
    """Write a file of kabu's cache, after removing the files of its folder unused since `stale`, a time. The cache only
    saves work, so a failure, or a file read half written, only means resolving again."""
    try:
        path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
        for old in path.parent.iterdir() if stale else ():
            try:
                if old.stat().st_mtime < stale:
                    old.unlink()
            except OSError:
                pass  # gone meanwhile, by another call's clean-up, or a folder: never in the way of the write
        path.write_text(text, encoding="utf-8")
    except OSError:
        pass


def gone_sessions(base: str) -> Tuple[Path, List[str]]:
    """The sessions the API at `base` reported gone (deleted with their project), which kabu never names again, and their
    file: one per base URL, as one API's ids mean nothing to another's."""
    path = cache_dir() / f"gone-{hashlib.sha256(base.encode()).hexdigest()[:12]}"
    try:
        return path, path.read_text(encoding="utf-8").split()
    except OSError:
        return path, []


def process_cwd(pid: int) -> Optional[Path]:
    """A process's working folder, or None: /proc on Linux; on macOS, libproc's proc_pidinfo, which lsof calls, in 0.3 ms
    where lsof took 0.3 s and more."""
    try:
        if sys.platform != "darwin":
            return Path(os.readlink(f"/proc/{pid}/cwd"))
        import ctypes
        size, at = 2352, 152  # struct proc_vnodepathinfo: the cwd's struct vnode_info, then its path, MAXPATHLEN 1024
        info = ctypes.create_string_buffer(size)
        if ctypes.CDLL("/usr/lib/libproc.dylib").proc_pidinfo(pid, 9, 0, info, size) != size:  # 9: PROC_PIDVNODEPATHINFO
            return None
        path = info.raw[at:at + 1024].split(b"\0", 1)[0]
        return Path(os.fsdecode(path)) if path else None
    except (OSError, ValueError, ImportError, AttributeError):  # gone, another user's, no libproc, or a Python without ctypes
        return None


# Process names of agent harnesses, looked for among kabu's ancestors.
AGENT_PROCESSES = {"claude": "claude-code", "copilot": "copilot-cli", "codex": "codex", "cursor-agent": "cursor", "gemini": "gemini-cli",
                   "opencode": "opencode", "aider": "aider", "goose": "goose", "amp": "amp", "pi": "pi"}
# Variables harnesses set for the commands they run; never their configuration, such as CODEX_HOME.
AGENT_VARIABLES = {"CLAUDECODE": "claude-code", "CLAUDE_CODE_ENTRYPOINT": "claude-code", "CURSOR_AGENT": "cursor",
                   "CURSOR_TRACE_ID": "cursor", "GEMINI_CLI": "gemini-cli", "CODEX_THREAD_ID": "codex", "CODEX_SANDBOX": "codex",
                   "PI_CODING_AGENT": "pi"}


class Proc(NamedTuple):
    """A process: its parent, start time ("" when unknown: it tells a process from a later one that reuses its id),
    executable name, and whether it is a zombie (exited, its parent has not reaped it)."""

    ppid: int
    start: str
    name: str
    zombie: bool = False


def processes(pids: Optional[Sequence[int]] = None) -> Dict[int, Proc]:
    """Processes by id: those named, else kabu's ancestors. Names only: arguments can hold secrets. Linux: /proc, read
    with the boot id; elsewhere one ps call, which may not show start times (BusyBox), and names are enough then."""
    procs: Dict[int, Proc] = {}
    if (PROC / "self" / "stat").exists():
        try:
            boot = (PROC / "sys" / "kernel" / "random" / "boot_id").read_text().strip()
        except OSError:
            boot = ""
        todo = list(pids) if pids is not None else [os.getppid()]
        while todo and len(procs) < 32 + len(pids or ()):
            pid = todo.pop()
            if pid <= 0 or pid in procs:
                continue
            try:
                stat = (PROC / str(pid) / "stat").read_text(errors="replace")
            except OSError:
                continue
            rest = stat[stat.rindex(")") + 2:].split()  # the fields after the name, which may hold spaces or parentheses
            procs[pid] = Proc(int(rest[1]), f"{boot}:{rest[19]}" if boot else "", stat[stat.index("(") + 1:stat.rindex(")")].lower(),
                              rest[0] == "Z")
            todo += [] if pids is not None else [procs[pid].ppid]
        return procs
    which, state = (["-A"], "") if pids is None else (["-p", ",".join(map(str, pids))], "stat=,")  # zombies, for the reporter
    starts = ((f"pid=,ppid=,{state}lstart=,comm=", r"(\w+ +\w+ +\d+ +[\d:]+ +\d+) +"), (f"pid=,ppid=,{state}comm=", "()"))  # with, then without
    for columns, start in starts if pids is None or pids else ():
        try:
            listing = subprocess.run(["ps", *which, "-o", columns], capture_output=True, text=True, errors="replace", timeout=2,
                                     env={**os.environ, "LC_ALL": "C", "TZ": "UTC0"}).stdout  # one format for start times
        except (OSError, subprocess.SubprocessError):
            break
        rows = re.findall(r"^\s*(\d+)\s+(\d+)\s+" + (r"(\S+)\s+" if state else "()") + start + r"(.+)$", listing, re.MULTILINE)
        procs = {int(pid): Proc(int(ppid), " ".join(when.split()), Path(comm).name.lower(), flags.startswith("Z"))
                 for pid, ppid, flags, when, comm in rows}
        if procs:
            break
    return procs


@functools.lru_cache(maxsize=None)
def ancestors() -> Tuple[Tuple[int, str, str], ...]:
    """kabu's ancestor processes, nearest first: process id, start time ("" when unknown) and executable name."""
    procs = processes()
    found: List[Tuple[int, str, str]] = []
    pid = os.getppid()
    while pid in procs and len(found) < 32:
        found.append((pid, procs[pid].start, procs[pid].name))
        pid = procs[pid].ppid
    return tuple(found)


def detect_agent(env: Mapping[str, str], names: Sequence[str]) -> str:
    """The harness running kabu: the nearest ancestor it knows, else AI_AGENT, else a variable a harness set, else kabu-cli."""
    found = [AGENT_PROCESSES[n] for n in names if n in AGENT_PROCESSES]
    found.append(re.sub(r"[^a-z0-9]+", "-", env.get("AI_AGENT", "").lower()).strip("-"))
    found += [agent for var, agent in AGENT_VARIABLES.items() if env.get(var, "").lower() not in ("", "0", "false")]
    return next((agent for agent in found if agent), "kabu-cli")[:64]


def resolve_agent(flag: Optional[str] = None) -> str:
    """--agent, KABU_AGENT (or AGENT_NOTIFIER_AGENT), the agent saved by kabu login, then the harness detected."""
    return resolve_setting(flag, ("KABU_AGENT", "AGENT_NOTIFIER_AGENT"), load_config(), "agent") or detect_agent(
        os.environ, [name for _, _, name in ancestors()])


class NoRedirect(urllib.request.HTTPRedirectHandler):
    """A 3xx is an HTTP error, never followed: urllib would send the bearer key on to wherever it points."""

    def redirect_request(self, req: urllib.request.Request, fp: Any, code: int, msg: str, headers: Any, newurl: str) -> None:
        return None


OPEN = urllib.request.build_opener(NoRedirect).open


@dataclass
class Api:
    """Kabu API v2 over urllib: JSON in and out, bounded retries; an API problem becomes a CliError (exit 3)."""

    base: str
    key: str = ""
    timeout: float = 30.0
    retries: int = RETRIES

    @classmethod
    def connect(cls, a: JSON) -> Api:
        """The client for --api-key and --base-url, else the environment, else the saved login."""
        cfg = load_config()
        key = resolve_setting(a.get("api_key"), ("KABU_API_KEY", "AGENT_NOTIFIER_API_KEY"), cfg, "api_key").strip()
        if not key:
            raise CliError("missing_api_key", "No Kabu API key.", "Set KABU_API_KEY=kabu_live_sk_…, or run: kabu login --api-key KEY")
        if not re.fullmatch(r"[\x21-\x7e]+", key):  # printable ASCII only: a header error would print the key whole
            raise CliError("invalid_api_key", "The API key (--api-key, KABU_API_KEY or the saved one) has a space, line break or "
                           "other character no key has.", "Save it again with: kabu login --api-key - < key.txt")
        return cls(base_url(a.get("base_url"), cfg), key, a.get("timeout") or 30.0)

    def call(self, method: str, path: str, body: Optional[JSON] = None, *, wait: int = 0, idem: str = "",
             form: Optional[Dict[str, str]] = None) -> JSON:
        """One API call; `idem` is the Idempotency-Key that makes a retried create return the first result."""
        headers = {"Accept": "application/json", "User-Agent": f"kabu-cli/{VERSION}",
                   **({"Authorization": f"Bearer {self.key}"} if self.key else {}), **({"Idempotency-Key": idem} if idem else {})}
        data = None
        if body is not None:
            data, headers["Content-Type"] = utf8_json(body), "application/json"
        if form is not None:
            data, headers["Content-Type"] = urllib.parse.urlencode(form).encode(), "application/x-www-form-urlencoded"
        raw = self.request(method, self.base + path + (f"?wait={wait}" if wait else ""), data, headers, self.timeout + wait)
        try:
            parsed = json.loads(raw) if raw.strip() else {}
        except ValueError:
            raise CliError("bad_response", f"{method} {path} did not return JSON.",
                           "Check that KABU_BASE_URL points at the Kabu API.", EXIT_TRANSPORT) from None
        return parsed if isinstance(parsed, dict) else {"data": parsed}

    def request(self, method: str, url: str, data: Optional[bytes], headers: Dict[str, str], timeout: float) -> bytes:
        """Send, and retry with the same headers, so the same Idempotency-Key, up to self.retries times."""
        attempt = 0
        while True:
            try:
                with OPEN(urllib.request.Request(url, data, headers, method=method), timeout=timeout) as resp:
                    return bytes(resp.read())
            except urllib.error.HTTPError as exc:
                error, delay = self.problem(exc, method, url, attempt)
            except (OSError, http.client.HTTPException) as exc:  # refused, reset, timed out
                error = CliError("network_error", f"{method} {url} failed: {getattr(exc, 'reason', exc)}.",
                                 "Check the network and KABU_BASE_URL, then run the same command again.", EXIT_TRANSPORT)
                delay = 0.5 * 2 ** attempt
            if delay is None or attempt == self.retries:
                raise error
            time.sleep(delay)
            attempt += 1

    @staticmethod
    def problem(exc: urllib.error.HTTPError, method: str, url: str, attempt: int) -> Tuple[CliError, Optional[float]]:
        """The API's problem (RFC 9457, or an OAuth error) as a CliError, and the seconds to wait before a retry (None: none)."""
        try:
            problem = json.loads(exc.read() or b"{}")
        except (ValueError, OSError):
            problem = {}
        problem = problem if isinstance(problem, dict) else {}
        status, after = exc.code, exc.headers.get("Retry-After") or ""
        code = str(problem.get("code") or problem.get("error") or f"http_{status}")
        message = problem.get("detail") or problem.get("error_description") or problem.get("title") or f"{method} {url}: HTTP {status}."
        fallback = "Run the same command again shortly." if status >= 500 else "Check the request, and the key and base URL (kabu whoami)."
        extra = {"status": status, **{k: problem[k] for k in ("param", "request_id") if problem.get(k)}}
        error = CliError(code, str(message), str(problem.get("hint") or fallback), EXIT_TRANSPORT, extra)
        if status < 500 and code != "idempotency_key_in_use" and not (status == 429 and after):
            return error, None  # quota_exceeded is a 429 without Retry-After: it lasts until the plan resets
        delay = float(after) if re.fullmatch(r"\d+(\.\d+)?", after) else 0.5 * 2 ** attempt
        return error, (delay if delay <= MAX_RETRY_AFTER else None)

    def upload(self, path: Path, idem: str) -> str:
        """Upload one file (POST /v2/media/uploads, then PUT the bytes) and return its med_ id."""
        raw = path.read_bytes()
        ctype = upload_type(path.name)
        up = self.call("POST", "/v2/media/uploads", {"filename": path.name, "content_type": ctype, "size": len(raw),
                                                      "sha256": hashlib.sha256(raw).hexdigest()}, idem=idem)
        media, url = up.get("media") or {}, up.get("upload_url")
        if not isinstance(url, str) or not isinstance(media.get("id"), str):
            raise CliError("bad_response", f"The upload of {path.name} returned no upload_url or media id.",
                           "Run the same command again.", EXIT_TRANSPORT)
        if media.get("status") != "ready":  # a replayed key may find the bytes already in place
            headers = {"Content-Type": ctype, **{k: v for k, v in (up.get("headers") or {}).items() if isinstance(v, str)}}
            self.request("PUT", self.base + url if url.startswith("/") else url, raw, headers, self.timeout)
        return str(media["id"])


def upload_type(name: str) -> str:
    """The Content-Type an upload of the file called name declares: UPLOAD_TYPES, mimetypes, then octet-stream."""
    ext = name.rpartition(".")[2].lower() if "." in name else ""
    return UPLOAD_TYPES.get(ext) or mimetypes.guess_type(name)[0] or "application/octet-stream"


def field_pair(cmd: str, item: str) -> JSON:
    """--field KEY=VALUE as the contract's {label, value}."""
    key, sep, val = (s.strip() for s in item.partition("="))
    if not sep or not 0 < len(key) <= 40 or len(val) > 200:
        raise CliError("invalid_value", f"--field {item!r} is not KEY=VALUE with a key of 1 to 40 characters and a value of up to 200.",
                       f"Example: kabu {SAMPLES[cmd]} --field env=prod")
    return {"label": key, "value": val}


def link(cmd: str, item: str) -> JSON:
    """--link LABEL=URL, or a bare URL; a bare URL's label is filled in from --url-title, else Open."""
    name, sep, url = item.partition("=")
    bare = not sep or "://" in name
    name, url = ("", item) if bare else (name.strip(), url)
    if not (bare or 0 < len(name) <= 40) or len(url) > 2048 or not re.fullmatch(r"[A-Za-z][A-Za-z0-9+.-]*:\S+", url):
        raise CliError("invalid_value", f"--link {item!r} is not LABEL=URL with a label of 1 to 40 characters and an "
                       "absolute URL of up to 2048.", f'Example: kabu {SAMPLES[cmd]} --link "PR=https://github.com/o/r/pull/7"')
    return {"label": name, "url": url}


def json_object(cmd: str, raw: str) -> JSON:
    """--args: one JSON object, finite numbers only, up to the contract's 16 KiB."""
    hint = f"""Example: kabu {SAMPLES[cmd]} --action db.migrate --args '{{"version": 42}}'"""
    try:
        args = json.loads(raw)
        size = len(json.dumps(args, allow_nan=False, ensure_ascii=False, separators=(",", ":")).encode())
    except ValueError as exc:
        raise CliError("invalid_value", f"--args is not valid JSON: {exc}.", hint) from None
    if not isinstance(args, dict) or size > 16 << 10:
        raise CliError("invalid_value", "--args must be one JSON object of up to 16 KiB.", hint)
    return args


def attachment(cmd: str, raw: str) -> Path:
    path = Path(os.path.expanduser(raw))  # unlike Path.expanduser, never raises for ~nosuchuser
    size = path.stat().st_size if path.is_file() and os.access(path, os.R_OK) else -1
    if size < 0:
        raise CliError("file_not_found", f"--file {raw}: no such file, or kabu cannot read it.",
                       f"Check the path. Example: kabu {SAMPLES[cmd]} --file ./a.png")
    if not 0 < size <= 2 ** 31:
        raise CliError("invalid_file", f"--file {raw} is {size} bytes; an attachment takes 1 byte to 2 GiB.",
                       "Attach a non-empty file under 2 GiB.")
    return path


@dataclass(frozen=True)
class Opt:
    """One option: how it parses, what it accepts, its default and where it lands in the request body."""

    flags: Tuple[str, ...]  # the first long flag names the value
    help: str
    example: str = ""  # a valid value, for help and error hints
    path: str = ""  # request body field, "a.b" to nest; empty when code builds it
    kind: str = "text"  # text, int, float, flag or list
    limit: int = 0  # most characters (text) or uses (list)
    bounds: Tuple[float, float] = (0, 0)  # range of an int or float
    choices: Tuple[str, ...] = ()
    pattern: str = ""  # a regex the whole value must match
    needs: str = ""  # an option this one requires
    ask: bool = False  # only on an ask
    metavar: Optional[str] = None
    default: Optional[Callable[[], Any]] = None  # the value when the option is not given
    convert: Optional[Callable[[str, str], Any]] = None  # (command, checked value) to what the request carries

    @property
    def dest(self) -> str:
        return self.flags[0].lstrip("-").replace("-", "_")


