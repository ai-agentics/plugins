def example(cmd: str, *opts: Opt) -> str:
    """A corrected command line for an error hint."""
    uses = [o.flags[0] + (f" {shlex.quote(o.example)}" if o.example else "") for o in opts]
    return " ".join(["Example: kabu", SAMPLES.get(cmd, cmd), *uses])


class Parser(argparse.ArgumentParser):
    """argparse that raises a CliError instead of printing usage and exiting."""

    color: bool  # Python 3.14+ colours help on a terminal; kabu never colours

    def error(self, message: str) -> NoReturn:
        raise CliError("usage", f"{self.prog}: {message}.", f"Run: {self.prog} --help")


def parse(cmd: str, args: Sequence[str]) -> JSON:
    """Parse one command's arguments; an unknown flag fails with the closest real one."""
    spec = COMMANDS[cmd]
    p = Parser(prog=f"kabu {cmd}", description=spec.about, epilog="examples:\n" + spec.examples + ENV_HELP, allow_abbrev=False,
               formatter_class=argparse.RawDescriptionHelpFormatter)
    p.color = False
    if spec.positional:
        name, nargs, help_ = spec.positional
        p.add_argument(name, nargs=nargs, help=help_, metavar=name.upper())
    for o in spec.opts:
        kw: JSON = {"action": "store_true"} if o.kind == "flag" else {"metavar": o.metavar}
        if o.kind == "list":
            kw.update(action="append", default=[])
        p.add_argument(*o.flags, dest=o.dest, help=argparse.SUPPRESS if o.ask and cmd == "send" else o.help, **kw)
    ns, extra = p.parse_known_intermixed_args(list(args))
    if extra:
        flag = extra[0].split("=", 1)[0]
        if not flag.startswith("-"):
            shown = "" if cmd == "login" else f" {extra[0]!r}"  # never echo what may be a key
            raise CliError("unexpected_argument", f"Unexpected argument{shown}.", f"Run: kabu {cmd} --help")
        by_flag = {f: o for o in spec.opts for f in o.flags}
        close = [] if flag in RENAMED else difflib.get_close_matches(flag, by_flag, n=1, cutoff=0.8)
        raise CliError("unknown_flag", f"kabu {cmd} has no {flag} flag." + (f" Did you mean {close[0]}?" if close else ""),
                       RENAMED.get(flag) or (example(cmd, by_flag[close[0]]) if close else f"Run: kabu {cmd} --help"))
    return vars(ns)


def given(value: Any) -> bool:
    return value is not None and value is not False and value != []


def check(cmd: str, opts: Sequence[Opt], a: JSON, asking: bool = False) -> JSON:
    """Fill in each row's default and check every option given against its row, before any HTTP call. Converts the values
    in place, and returns the request body fields the rows name (a.b nests)."""
    by_dest = {o.dest: o for o in opts}
    body: JSON = {}
    for o in opts:
        if o.default and not given(a.get(o.dest)):
            a[o.dest] = o.default()
        if not given(a.get(o.dest)):
            continue
        if o.ask and not asking:
            raise CliError("ask_only", f"{o.flags[0]} only applies to an ask.", example("ask", o))
        if o.needs and not given(a.get(o.needs)):
            raise CliError("missing_flag", f"{o.flags[0]} needs {by_dest[o.needs].flags[0]}.", example(cmd, by_dest[o.needs], o))
        a[o.dest] = value(cmd, o, a[o.dest])
        if o.path:
            parent, _, key = o.path.rpartition(".")
            node = body.setdefault(parent, {}) if parent else body
            node[key] = a[o.dest]
    return body


def value(cmd: str, o: Opt, raw: Any) -> Any:
    """One option's value, checked against its limit, range, choices or pattern, then converted."""
    flag = o.flags[0]
    if o.kind == "flag":
        return True
    if o.kind == "list":
        if o.limit and len(raw) > o.limit:
            raise CliError("too_many", f"{flag} is given {len(raw)} times; the limit is {o.limit}.", example(cmd, o))
        return [o.convert(cmd, item) for item in raw] if o.convert else raw
    text = str(raw)
    if o.kind in ("int", "float"):
        lo, hi = o.bounds
        number = float(text) if re.fullmatch(r"\d+" if o.kind == "int" else r"\d+(\.\d+)?", text) else float("nan")
        if not lo <= number <= hi:
            kind = "a whole number" if o.kind == "int" else "a number"
            raise CliError("invalid_value", f"{flag} must be {kind} from {lo} to {hi}, not {text!r}.", example(cmd, o))
        return int(number) if o.kind == "int" else number
    if o.choices and text not in o.choices:
        close = difflib.get_close_matches(text, o.choices, n=1)
        raise CliError("invalid_value", f"{flag} {text!r} is not one of {', '.join(o.choices)}."
                       + (f" Did you mean {close[0]!r}?" if close else ""), example(cmd, o))
    if o.limit and len(text) > o.limit:
        raise CliError("too_long", f"{flag} is {len(text)} characters; the limit is {o.limit}.", example(cmd, o))
    if o.pattern and not re.fullmatch(o.pattern, text):
        shown = "" if flag == "--api-key" else f" {text!r}"  # never echo a key
        raise CliError("invalid_value", f"{flag}{shown} is not valid; it looks like {o.example}.", example(cmd, o))
    return o.convert(cmd, text) if o.convert else text


def texts(cmd: str, a: JSON) -> Tuple[str, str]:
    """The title (default: the message's first line) and the body. One argument is the message, two are TITLE MESSAGE,
    and a value of - is read from stdin, for one value at most."""
    named = [k for k in ("title", "ask", "ask_text") if a[k] is not None]
    if len(named) > 1:
        raise CliError("conflicting_flags", "--title, --ask and --ask-text all set the title: give one.", f'{example("ask")} "Canary is green"')
    a["title"] = a[named[0]] if named else None
    words, free = a["text"], [k for k in ("title", "message") if a[k] is None]
    if len(words) > len(free):
        raise CliError("unexpected_argument", f"Too many arguments: {' '.join(map(repr, words))}.",
                       f'One argument is the message, two are TITLE MESSAGE; quote multi-word text. {example(cmd)} "412 passed"')
    a.update(zip(free[-len(words):], words))
    dashes = [k for k in ("message", "code", "diff", "quote") if a[k] == "-"]
    if len(dashes) > 1:
        raise CliError("conflicting_flags", f"Only one value can read stdin (-), not {len(dashes)}: {', '.join(dashes)}.",
                       f"Pass the others as text. Example: git diff | kabu {SAMPLES[cmd]} --diff - --quote 'Looks good'")
    if dashes:
        a[dashes[0]] = sys.stdin.buffer.read().decode("utf-8", "replace")
    message = (a["message"] or "").strip()
    title = (a["title"] or "").strip() or message.split("\n", 1)[0][:TITLE_MAX].strip()
    if not title:
        raise CliError("missing_text", "Nothing to send: give a message.", example(cmd))
    if len(title) > TITLE_MAX:
        raise CliError("too_long", f"The title is {len(title)} characters; the limit is {TITLE_MAX}.",
                       f'Put the detail in the message. Example: kabu {cmd} "Deploy to prod?" "Canary is green"')
    if len(message) > BODY_MAX:
        raise CliError("too_long", f"The message is {len(message)} characters; the limit is {BODY_MAX}.",
                       f'Shorten it, or attach the whole text. Example: kabu {cmd} "Nightly report" "Summary" --file report.md')
    return title, message or title


def option(index: int, choice: str) -> Dict[str, str]:
    """-c LABEL, or -c ID:LABEL when ID is an id (a letter, then letters, digits, _ . or -) and no space follows the colon,
    so 10:00 and "Retry: once" stay whole labels. The id defaults to the label in lower case, with _ for anything else."""
    split = re.fullmatch(r"([A-Za-z][A-Za-z0-9_.-]{0,63}):(\S.*)", choice.strip())
    label = (split.group(2) if split else choice).strip()
    oid = split.group(1) if split else "".join(ch if ch.isascii() and ch.isalnum() else "_" for ch in label.lower()).strip("_")[:64]
    if not 0 < len(label) <= 40:
        raise CliError("invalid_value", f"-c {choice!r} needs a label of 1 to 40 characters.",
                       'Example: kabu ask "Which env?" -c staging -c "prod:Production (EU)"')
    return {"id": oid or f"opt_{index}", "label": label}


def ask_body(a: JSON) -> JSON:
    """The ask: confirm by default, choice with -c, or the --type given."""
    choices: List[str] = a["choice"]
    kind = a["type"] or ("text" if a["ask_text"] else "choice" if choices else "confirm")
    if kind == "text" or a["ask_text"]:
        if choices or kind != "text":
            raise CliError("conflicting_flags", "A text ask takes no -c and no other --type.", 'Example: kabu ask "Release name?" --type text')
        return {"type": kind}
    if kind == "confirm":
        if choices and (len(choices) != 2 or any(not 0 < len(c) <= 40 for c in choices)):
            raise CliError("invalid_value", "A confirm ask takes no -c, or two labels of up to 40 characters: approve, then reject.",
                           'Example: kabu ask "Ship it?" --type confirm -c Ship -c Wait')
        options = [{"id": d, "label": c, "decision": d} for d, c in zip(("approve", "reject"), choices)]
        return {"type": kind, **({"options": options} if options else {})}
    if len(choices) < 2:
        raise CliError("too_few", f"A {kind} ask needs 2 to 12 -c options, not {len(choices)}.",
                       'Example: kabu ask "Which env?" -c staging -c prod')
    options = [option(i, c) for i, c in enumerate(choices, 1)]
    if len({o["id"] for o in options}) < len(options):
        raise CliError("invalid_value", "Two -c options have the same id.", "Give each its own id: -c stg:Staging -c prd:Production")
    return {"type": kind, "options": options, **({"min": 1, "max": len(options)} if kind == "multi" else {})}


def build_message(cmd: str, a: JSON) -> Tuple[JSON, List[Path], JSON]:
    """The validated request body and files for send or ask, and the project and its source. No HTTP call."""
    if a["project"] in PRIORITY_NUMBERS:  # kabu.py's -p was its priority
        raise CliError("invalid_value", f"--project {a['project']!r} looks like kabu.py's -p priority; in kabu, -p is --project.",
                       f"Example: kabu {SAMPLES[cmd]} --priority {PRIORITY_NUMBERS[a['project']]}")
    asking = cmd == "ask"
    title, message = texts(cmd, a)
    body: JSON = {"title": title, "body": message, **check(cmd, MESSAGE, a, asking)}
    for each in body.get("links", []):
        each["label"] = each["label"] or a["url_title"] or "Open"
    for kind, extra, key in (("code", "language", "language"), ("diff", "diff_path", "path"), ("quote", "", "")):
        if given(a[kind]):
            body.setdefault("blocks", []).append({"type": kind, "text": a[kind], **({key: a[extra]} if extra and a[extra] else {})})
    if "voice" in body:
        body["voice"]["speak"] = True  # --voice and --speed imply --as-audio
        if not asking and len(a["file"]) > 9:
            raise CliError("too_many", "A spoken notify takes 9 files: speech fills the tenth attachment.", "Attach up to 9 files.")
    if asking:
        body["ask"] = {**ask_body(a), **body.get("ask", {})}
        body.setdefault("expires_in", 300)
    source = with_project(cmd, body)  # last, for a valid command only: it is the slowest step
    size = len(utf8_json(body)) + 64 * (len(a["file"]) + 1)  # and room for the media and session ids added later
    if size > REQUEST_MAX:
        raise CliError("too_large", f"The request comes to {size} bytes; the API takes up to {REQUEST_MAX} (64 KiB of UTF-8 JSON).",
                       f'Shorten the text, or attach it. Example: kabu {cmd} "Nightly report" "Summary" --file report.md')
    return body, a["file"], {"project": body.get("project"), "project_source": source}


def with_project(cmd: str, body: JSON) -> JSON:
    """Put the resolved project in a request body that has none from --project, checked as --project is; its source."""
    if "project" in body:
        return {"rule": "flag"}
    project, source = resolve_project()
    body.update({"project": value(cmd, PROJECT, project)} if project else {})
    return source


def the_id(cmd: str, raw: Optional[str], prefix: str, env: str = "") -> str:
    """A msg_ or ses_ id from the argument, else the environment variable: checked before any HTTP call, quoted for a URL."""
    got = raw or (os.environ.get(env) if env else None) or ""
    if not re.fullmatch(prefix + r"\S+", got):
        raise CliError("invalid_id", f"kabu {cmd} needs a {prefix}… id" + (f" (or {env})" if env else "")
                       + (f", not {got!r}." if got else "."), f"Example: kabu {cmd} {prefix}01J9Z")
    return urllib.parse.quote(got, safe="")


def classify_ask_outcome(msg: JSON, kind: str) -> Tuple[JSON, int]:
    """The printed answer of an ask, and its exit code: 0 only for an explicit approve, or the answer to a choice, multi
    or text ask; 10 for a reject, or a typed reply to a confirm (kind); 3 for any other decision, or none."""
    status, resolution = str(msg.get("status") or "unknown"), msg.get("resolution")
    r: JSON = resolution if isinstance(resolution, dict) else {}
    decision = "reject" if r.get("decision") == "deny" else r.get("decision")  # deny: the legacy name; never inferred
    seen = {"id": msg.get("id"), "outcome": status, "status": status, "decision": decision}
    if status in ("expired", "cancelled"):
        return seen, EXIT_EXPIRED if status == "expired" else EXIT_CANCELLED
    option, options = r.get("option"), r.get("options")
    choices = [str(x) for x in options] if isinstance(options, list) else [option] if isinstance(option, str) and option else None
    answer = {**seen, "option": option, "choices": choices, "text": r.get("text"), "values": r.get("values"), "via": r.get("via")}
    if status == "answered" and (decision == "approve" or decision == "respond" and kind != "confirm"):
        return answer, EXIT_OK
    return answer, EXIT_REJECTED if status == "answered" and decision in ("reject", "respond") else EXIT_TRANSPORT


def cmd_message(cmd: str, a: JSON) -> int:
    """send or ask: upload the files, create the message and, for an ask, wait until it settles."""
    body, files, context = build_message(cmd, a)
    api = Api.connect(a)
    gone = body.pop("session") if "session" in body and body["session"] in gone_sessions(api.base)[1] else None  # one stands in
    if a["dry_run"]:  # the API validates it and renders each surface; nothing is uploaded or sent
        return emit({"ok": True, "dry_run": True, "request": body, "files": [str(f) for f in files],
                     "preview": api.call("POST", "/v2/messages/preview", body), "project_source": context["project_source"]})
    key = str(uuid.uuid4())  # one Idempotency-Key per invocation: a retry never sends twice
    joined, folder, lane = presence_join(api) if "session" not in body and not gone else (None, None, "")
    if joined:
        body["session"] = joined  # the agent session's own, which its hooks report live
    if "session" not in body and (gone or os.environ.get("KABU_AUTO_SESSION") == "1"):
        auto_session(api, body, key, session_key(harness()) if gone else "")  # a gone session's stand-in: this session's
    if files:
        body["attachments"] = [{"media": api.upload(f, f"{key}-file-{i}")} for i, f in enumerate(files, 1)]
    try:
        msg = api.call("POST", "/v2/messages", body, idem=key)  # an ask waits below, by its id: a 404 there is ask_gone
    except CliError as e:
        if not joined or e.code != "session_ended":
            raise
        if folder is not None:
            lane_ended(folder, lane)  # the presence session was ended: the message goes without it, and the next one gets a new one
        body.pop("session")
        msg = api.call("POST", "/v2/messages", body, idem=key + "-alone")
    if body.get("session") and msg.get("session", body["session"]) is None:  # the API dropped it: deleted with its project
        gone = body["session"]
        path, known = gone_sessions(api.base)
        write_cache(path, "\n".join([*known, gone][-100:]) + "\n")  # the last 100
    context.update(session=msg.get("session"), **({"session_gone": gone} if gone else {}))
    if cmd == "send" or a["no_wait"]:
        done: JSON = {"attachments": len(files)} if cmd == "send" else {"outcome": "pending"}
        return emit({"ok": True, "id": msg.get("id"), "status": msg.get("status"), **done, **context})
    mid, deadline = str(msg.get("id")), time.monotonic() + body["expires_in"] + GRACE  # the API settles an ask at expiry
    hint = f"The ask is still open, so never ask it again; wait for its answer with: kabu status {mid} --wait 50"
    while msg.get("status") == "pending":
        if time.monotonic() > deadline:
            raise CliError("ask_pending", f"No answer to {mid} by its expiry; kabu stopped waiting.", hint, EXIT_TRANSPORT, {"id": mid})
        try:
            msg = api.call("GET", "/v2/messages/" + urllib.parse.quote(mid, safe=""), wait=WAIT)
        except CliError as e:  # a network blip, 5xx or 429 only delays the wait; a refusal ends it
            if e.extra.get("status") == 404:  # deleted, as with its project: no answer will ever come, so never wait on
                raise CliError("ask_gone", f"{mid} was deleted (as when its project is), so it will never be answered.",
                               "Ask again if you still need it.", EXIT_CANCELLED, {**e.extra, "id": mid}) from None
            if 400 <= e.extra.get("status", 0) < 500 and e.extra["status"] != 429:
                raise CliError(e.code, e.message, hint, e.exit, {**e.extra, "id": mid}) from None
            time.sleep(5)
    summary, code = classify_ask_outcome(msg, body["ask"]["type"])
    return emit({**summary, **context}, code, sort=True)


def auto_session(api: Api, body: JSON, key: str, scope: str = "") -> None:
    """KABU_AUTO_SESSION=1: one session per host, project and agent groups their messages and shows on the Lock Screen
    (a Live Activity; each ask in it has its own). One try of up to 3 s; an ended or expired session (the API returns a
    run's session even then), or any failure, sends the message without one. With no project in the message, the session
    names none either: the API picks it as for the message (a bound key's). A `scope`, this agent session's key, makes it
    this session's own, as a gone session's stand-in is."""
    host, project, agent = socket.gethostname().split(".")[0], body.get("project"), body["agent"]
    tail = f":{scope}" if scope else ""
    try:
        session = Api(api.base, api.key, 3.0, 0).call("POST", "/v2/sessions", {
            "title": f"{agent} on {host}{f' · {project}' if project else ''}"[:80], **({"project": project} if project else {}),
            "agent": agent, "external_id": f"auto:{host}:{project or ''}:{agent}"[:120 - len(tail)] + tail,
            "live": {"enabled": True}}, idem=f"{key}-session")
    except CliError:
        return  # a session only groups messages: it never stops one
    if isinstance(session.get("id"), str) and session.get("status") not in ("ended", "expired") and not session.get("ended_at"):
        body["session"] = session["id"]


def cmd_session(cmd: str, a: JSON) -> int:
    """session start (get or create, with a Live Activity), update or end."""
    body, action = check(cmd, COMMANDS[cmd].opts, a), cmd.split()[1]
    update = {k: body.pop(k) for k in ("headline", "progress") if k in body}  # what session update takes
    if action != "start":
        sid = the_id(cmd, a["id"], "ses_", "KABU_SESSION")
        if action == "update" and not update:
            raise CliError("missing_flag", "Nothing to update.", "Example: kabu session update --headline 'Running tests' --progress 3/8")
        api, another = Api.connect(a), 'start another: kabu session start --title "…"'
        if sid in gone_sessions(api.base)[1]:  # the API reported it gone, deleted with its project: no call can reach it
            raise CliError("session_gone", f"{sid} no longer exists: it was deleted (as when its project is).",
                           another.capitalize() + ".", EXIT_TRANSPORT, {"id": sid})
        try:
            return emit(api.call("POST", f"/v2/sessions/{sid}/end", body, idem=str(uuid.uuid4())) if action == "end"
                        else api.call("PATCH", f"/v2/sessions/{sid}", update))
        except CliError as e:
            raise if_gone(e, another) from None
    if not a["title"]:
        raise CliError("missing_flag", "kabu session start needs --title.", 'Example: kabu session start --title "Fix flaky auth test"')
    with_project(cmd, body)
    api = Api.connect(a)
    session = api.call("POST", "/v2/sessions", {**body, "live": {"enabled": True}}, idem=str(uuid.uuid4()))
    if session.get("status") == "ended":  # get-or-create found this --external-id's session, already over
        raise CliError("session_ended", f"The session of --external-id {a['external_id']} has ended.",
                       "Start another with a new --external-id.", EXIT_TRANSPORT)
    if update:
        session = api.call("PATCH", "/v2/sessions/" + urllib.parse.quote(str(session.get("id")), safe=""), update)
    return emit(session)


def cmd_status(cmd: str, a: JSON) -> int:
    check(cmd, STATUS, a)
    try:
        return emit(Api.connect(a).call("GET", "/v2/messages/" + the_id(cmd, a["id"], "msg_"), wait=a["wait"] or 0))
    except CliError as e:
        raise if_gone(e, "it will never be answered, so do not wait on it; ask again if you still need it") from None


def if_gone(e: CliError, then: str) -> CliError:
    """The API's 404 for a message or session, with a hint that says what it means; any other error as it is."""
    return CliError(e.code, e.message, f"It was deleted (as when its project is) or never existed: {then}.", e.exit,
                    e.extra) if e.extra.get("status") == 404 else e


def cmd_whoami(cmd: str, a: JSON) -> int:
    check(cmd, CONNECTION, a)
    api = Api.connect(a)
    capabilities = api.call("GET", "/v2")
    try:
        org: Optional[JSON] = api.call("GET", "/v2/org")
    except CliError:
        org = None  # GET /v2/org needs org:write, which agent keys lack; GET /v2/me takes only a signed-in human
    project, source = resolve_project()
    return emit({"ok": True, "capabilities": capabilities, "org": org, "org_name": (org or {}).get("name") or load_config().get("org_name"),
                 "project": project, "project_source": source, "agent": resolve_agent(), "base_url": api.base,
                 "config_path": str(default_config_path())})


def device_login(api: Api, name: str) -> JSON:
    """RFC 8628: print a code for a person to approve in Kabu, then poll for this computer's own key."""
    auth = api.call("POST", "/v2/device_authorizations", {"name": name})
    link = auth.get("verification_uri_complete") or auth.get("verification_uri")
    print(f"In the Kabu app, open Connect a computer and enter the code: {auth.get('user_code')}"
          + (f"\nOr approve it in a browser: {link}" if link else "") + "\nOnly an admin or owner of the workspace can approve it.",
          file=sys.stderr, flush=True)
    form = {"device_code": str(auth.get("device_code", "")), "grant_type": "urn:ietf:params:oauth:grant-type:device_code"}
    interval, deadline = float(auth.get("interval", 5)), time.monotonic() + float(auth.get("expires_in", 600))
    while time.monotonic() < deadline:
        time.sleep(interval)
        try:
            return api.call("POST", "/v2/device_authorizations/poll", form=form)
        except CliError as e:  # the API answers a poll with an OAuth error code only
            if e.code == "access_denied":
                raise CliError(e.code, "The code was denied in Kabu.", "Run kabu login --device again.", EXIT_REJECTED) from None
            if e.code == "expired_token":
                break
            if e.code not in ("authorization_pending", "slow_down"):
                raise
            interval += 5 if e.code == "slow_down" else 0
    raise CliError("expired_token", "The code expired before anyone approved it.", "Run kabu login --device again.", EXIT_EXPIRED)


def cmd_login(cmd: str, a: JSON) -> int:
    """Save a key (--api-key, or typed at a terminal) or get this computer's own (--device), and the defaults given."""
    if a["api_key"] == "-":
        a["api_key"] = sys.stdin.buffer.readline().decode("utf-8", "replace")
    a["api_key"] = a["api_key"] and a["api_key"].strip()  # a key file with Windows line endings leaves a \r
    check(cmd, LOGIN, a)
    if a["api_key"] and a["device"]:
        raise CliError("conflicting_flags", "Give --api-key or --device, not both.", "Example: kabu login --device")
    cfg = load_config()
    cfg.update(base_url=base_url(a["base_url"], cfg), **{k: a[k] for k in ("project", "agent") if a[k]})
    known: JSON = {}
    if a["device"]:
        token = device_login(Api(cfg["base_url"]), a["name"])
        known = {k: token[k] for k in ("org_name", "project") if token.get(k)}
        cfg.update(api_key=str(token.get("access_token", "")), **({"org_name": known["org_name"]} if "org_name" in known else {}))
    else:
        typed = "" if a["api_key"] or not sys.stdin.isatty() else getpass.getpass("Kabu API key: ").strip()
        if not a["api_key"] and not typed:
            raise CliError("missing_flag", "kabu login needs --device or --api-key.", "Example: kabu login --device")
        cfg["api_key"] = a["api_key"] or value(cmd, KEY, typed)
    return emit({"ok": True, **known, "config_path": str(save_config(cfg))})


def tool_project() -> Optional[str]:
    """The project kabu mcp adds to a tool call, resolved for that call as kabu send would: one rules 1 to 5 name (the
    environment, the session, the folder, the login), never a <folder>@<host> name, nor none."""
    project, source = resolve_project()
    return project if source["rule"] not in ("folder", "default") else None


def cmd_mcp(cmd: str, a: JSON) -> int:
    """Bridge a harness's stdio MCP to the API's /mcp with the saved key (CONTRACT.md, MCP bridge). Logs go to stderr."""
    import threading

    check(cmd, CONNECTION, a)
    api = Api.connect(a)
    url, out = api.base + "/mcp", threading.Lock()
    session: Dict[str, str] = {}  # the Mcp-Session-Id the server issued, sent on every later request
    takes: Set[str] = set()  # the tools whose input has a project, from tools/list
    try:  # a key bound to a project sends as it, and another project would be refused (403): then add none
        bound = bool(Api(api.base, api.key, 3.0, 0).call("GET", "/v2").get("project"))
    except CliError:
        bound = True  # not known: add none, as before 2.4.0

    def write(reply: Any) -> None:
        with out:
            try:
                print(json.dumps(reply), flush=True)
            except OSError:
                pass  # the harness has gone, and stdin ends next

    def relay(line: bytes, show: Callable[[Any], None]) -> None:
        """POST one message, and show each message of the reply as it comes: the JSON body, or each event of a stream."""
        headers = {"Content-Type": "application/json", "Accept": "application/json, text/event-stream",
                   "Authorization": f"Bearer {api.key}", "User-Agent": f"kabu-cli/{VERSION}", **session}
        with OPEN(urllib.request.Request(url, line, headers, method="POST"), timeout=api.timeout + WAIT) as resp:
            if resp.headers.get("Mcp-Session-Id"):
                session["Mcp-Session-Id"] = resp.headers["Mcp-Session-Id"]
            if "text/event-stream" not in resp.headers.get("Content-Type", ""):
                body = resp.read()
                if body.strip():  # a notification's 202 has none
                    show(json.loads(body))
                return
            data: List[str] = []
            for raw in resp:  # an event stream: the data lines of each event are one message
                text = raw.decode().rstrip("\r\n")
                if text.startswith("data:"):
                    data.append(text[5:].removeprefix(" "))
                elif not text and data:
                    show(json.loads("\n".join(data)))
                    data = []

    def forward(line: bytes, msg: Any) -> None:
        """Relay one message. On failure, log it, and answer a request that has no answer yet with a JSON-RPC error:
        the harness never hangs, and never gets two answers for one id."""
        rid = msg.get("id") if isinstance(msg, dict) and "method" in msg else None  # a request's id: it wants an answer
        answered = False

        def show(reply: Any) -> None:
            nonlocal answered
            if isinstance(msg, dict) and msg.get("method") == "tools/list":
                try:
                    takes.update(t["name"] for t in reply["result"]["tools"] if "project" in t["inputSchema"]["properties"])
                except (KeyError, TypeError):
                    pass  # a list without schemas: no tool gets a project
            write(reply)
            answered = answered or isinstance(reply, dict) and "method" not in reply and reply.get("id") == rid

        try:
            relay(line, show)
            if answered or rid is None:
                return
            raise ValueError("no answer")  # an empty body, or a stream that ended without the response
        except urllib.error.HTTPError as exc:
            e = Api.problem(exc, "POST", url, RETRIES)[0]
        except ValueError:
            e = CliError("bad_response", f"POST {url} did not answer with JSON-RPC.", "Check that KABU_BASE_URL points at the Kabu API.")
        except (OSError, http.client.HTTPException) as exc:  # refused, reset, timed out
            e = CliError("network_error", f"POST {url} failed: {getattr(exc, 'reason', exc)}.", "Check the network and KABU_BASE_URL.")
        printed = error_line(e)
        print(printed, file=sys.stderr, flush=True)
        if rid is not None and not answered:
            shown = json.loads(printed)["error"]  # as redacted: message and hint, then the code and the rest as data
            write({"jsonrpc": "2.0", "id": rid, "error": {"code": -32000, "message": f"{shown.pop('message')} {shown.pop('hint')}",
                                                          "data": shown}})

    pending: List[threading.Thread] = []
    for line in filter(None, (raw.strip() for raw in sys.stdin.buffer)):
        try:
            msg = json.loads(line)
        except ValueError:
            msg = None  # sent as it is: the server answers with a parse error
        call = msg.get("params") if isinstance(msg, dict) and msg.get("method") == "tools/call" else None
        call = call if isinstance(call, dict) else {}
        tool = call.get("name")  # a str, unless the harness sent something odd
        args = call.setdefault("arguments", {}) if isinstance(tool, str) and tool in takes and not bound else None
        project = tool_project() if isinstance(args, dict) and not args.get("project") else None
        if project and isinstance(args, dict):
            args["project"] = project
            line = json.dumps(msg).encode()
        if isinstance(msg, dict) and "method" in msg and "id" in msg:  # a request runs alongside the others
            pending = [t for t in pending if t.is_alive()] + [threading.Thread(target=forward, args=(line, msg), daemon=True)]
            pending[-1].start()
        else:  # notifications and replies keep their order
            forward(line, msg)
    for thread in pending:
        thread.join()
    return EXIT_OK


# ---------------------------------------------------------------------------------------------------- presence --
# Is the agent live? (ADR 021) A hook writes a record at each event of an agent session on this machine; one
# `kabu presence run` folds them into PUT /v2/presence: a batch a minute, and one at each change. What leaves the
# machine: state enums, HMAC'd ids, the harness's name and the project the session runs in, as kabu send sends.
PRESENCE_TICK = 2.0  # seconds between looks at the records and at their harnesses' processes
PRESENCE_SETTLE = 5.0  # working <-> idle waits this long: a turn that ends as the next one starts sends nothing
PRESENCE_BEAT = 60  # seconds between batches while nothing changes, unless the API's next_beat_in says otherwise
PRESENCE_PER_MINUTE = 10  # batches in any 60 s: the API takes 12 a minute from one reporter
PRESENCE_DECAY = 900.0  # a turn with no event for 15 minutes, and no tool running, reads idle
PRESENCE_EXIT = 600.0  # kabu presence run exits after 10 minutes with no agent session to report
PRESENCE_RECHECK = 10.0  # seconds between checks that a harness is no zombie, and still the process that started
PRESENCE_REPORTS = 20  # the most reports one batch takes
PRESENCE_FORGET = 300.0  # an exited session that could not be reported offline is dropped after this; its lease lapses
PRESENCE_TORN = 10.0  # an empty or unreadable record this old is a hook stopped mid-write: removed
HOOK_EVENTS = ("SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Notification", "Stop", "SessionEnd")
COPILOT_EVENTS = {"SessionStart": "sessionStart", "UserPromptSubmit": "userPromptSubmitted", "PreToolUse": "preToolUse",
                  "PostToolUse": "postToolUse", "Notification": "notification", "Stop": "agentStop", "SessionEnd": "sessionEnd"}
NEEDS_INPUT = "permission_prompt|elicitation_dialog|elicitation_url_dialog|worker_permission_prompt|agent_needs_input"
HOOK_FILE = "presence-hook.sh"  # kabu presence install writes the hook here, in KABU_HOME, and knows its entries by it
HOOK_CLI = 'kabu_cli="${CLAUDE_PLUGIN_ROOT:-.}/bin/kabu"'  # the plugin's; install puts this CLI's path in its place
RECORD = re.compile(r"l(\d+)-(\d+)\.json")  # a hook's record: the harness's process id, and the event's seq
# The hook: a harness's shell sources it in a subshell ((. FILE) || true), so it runs no program of its own, which
# costs 5 to 10 ms on a Mac. Each event is a new file, created no-clobber (O_EXCL: never through a link, never over
# another file) at the next free seq, so concurrent hooks never lose one another's events and the order is the seq
# order. It never reads its input, which a harness may hold open: the session id is Claude Code's CLAUDE_CODE_SESSION_ID
# (else the harness's process id and start time stand for it), and the Notification matcher picks the types that need
# the user. scripts/plugin.py writes it to plugins/kabu/hooks/presence.sh.
PRESENCE_HOOK = r"""# Kabu presence hook for Claude Code and Copilot CLI (ADR 021). Generated by kabu: do not edit.
# Hook command: kabu_event=EVENT; (. THIS_FILE) || true   It starts no program but the reporter, never reads its
# input (so it never waits for it), has no unbounded loop, and always exits 0.
# Each event is a new 0600 record, created no-clobber in this user's machine-local folder (0700, never a link):
# ${KABU_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}}/kabu-presence-$USER/l<harness pid>-<seq>.json: the state,
# the harness's process and session ids and the Herdr pane. Never a prompt, path or tool name, never the network.
# It starts `kabu presence run`, which reports, when none runs. Off: KABU_PRESENCE=0 or `kabu presence off`.
kabu_cli="${CLAUDE_PLUGIN_ROOT:-.}/bin/kabu"
umask 077
exec 2>/dev/null
[ "${KABU_PRESENCE:-}" = 0 ] && exit 0
[ -e "${KABU_HOME:-$HOME/.kabu}/presence/off" ] && exit 0
kabu_att=null
case "${kabu_event:-}" in
  SessionStart|sessionStart) kabu_rt=idle kabu_ev=start ;;
  UserPromptSubmit|userPromptSubmitted) kabu_rt=working kabu_ev=prompt ;;
  PreToolUse|preToolUse) kabu_rt=working kabu_ev=tool ;;
  PostToolUse|postToolUse) kabu_rt=working kabu_ev=post ;;
  Notification|notification) kabu_rt=working kabu_ev=attention kabu_att='"terminal"' ;;
  Stop|agentStop) kabu_rt=idle kabu_ev=stop ;;
  SessionEnd|sessionEnd) kabu_rt=offline kabu_ev=end ;;
  *) exit 0 ;;
esac
kabu_dir=${KABU_RUNTIME_DIR:-${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}}
kabu_dir="${kabu_dir%/}/kabu-presence-${USER:-${LOGNAME:-}}"
[ -L "$kabu_dir" ] && exit 0
[ -d "$kabu_dir" ] || mkdir -m 700 "$kabu_dir" || exit 0
[ -O "$kabu_dir" ] && [ ! -L "$kabu_dir" ] || exit 0
kabu_sid=
[ "${CLAUDE_PID:-}" = "$PPID" ] && kabu_sid=${CLAUDE_CODE_SESSION_ID:-}
kabu_pane=${HERDR_PANE_ID:-}
case $kabu_pane in *[!A-Za-z0-9._:-]*) kabu_pane= ;; esac
[ ${#kabu_pane} -le 40 ] || kabu_pane=
kabu_put() {
  case $kabu_sid in *[!A-Za-z0-9._:-]*) kabu_sid= ;; esac
  [ ${#kabu_sid} -le 64 ] || kabu_sid=
  kabu_max=0 kabu_n=0
  for kabu_f in "$kabu_dir"/l"$PPID"-*.json; do
    kabu_s=${kabu_f##*-}; kabu_s=${kabu_s%.json}
    case $kabu_s in ''|*[!0-9]*) continue ;; esac
    kabu_n=$((kabu_n + 1))
    [ "$kabu_s" -gt "$kabu_max" ] && kabu_max=$kabu_s
  done
  [ "$kabu_n" -lt 200 ] || return 0
  set -C
  kabu_seq=$kabu_max
  while [ "$kabu_seq" -lt $((kabu_max + 32)) ]; do
    kabu_seq=$((kabu_seq + 1))
    kabu_f="$kabu_dir/l$PPID-$kabu_seq.json"
    { [ -e "$kabu_f" ] || [ -L "$kabu_f" ]; } && continue
    printf '%s\n' "{\"v\":2,\"event\":\"$kabu_ev\",\"runtime\":\"$kabu_rt\",\"attention\":$kabu_att,\"seq\":$kabu_seq,\"pid\":$PPID,\"sid\":\"$kabu_sid\",\"pane\":\"$kabu_pane\"}" > "$kabu_f" && return 0
  done
}
kabu_put
case $kabu_ev in tool|post) exit 0 ;; esac
kabu_run=0
[ -f "$kabu_dir/run.pid" ] && [ ! -L "$kabu_dir/run.pid" ] && { IFS= read -r kabu_run < "$kabu_dir/run.pid" || :; }
case $kabu_run in ''|*[!0-9]*) kabu_run=0 ;; esac
if [ "$kabu_ev" = start ] || [ "$kabu_run" -le 1 ] || ! kill -0 "$kabu_run"; then
  (python3 "$kabu_cli" presence run </dev/null >/dev/null 2>&1 &)
fi
exit 0
"""


def kabu_home() -> Path:
    """kabu's state that lasts (KABU_HOME, else ~/.kabu): presence's off switch, reporter identities and the hook."""
    return Path(os.environ.get("KABU_HOME") or Path.home() / ".kabu")


def presence_dir() -> Path:
    return kabu_home() / "presence"


def runtime_dirs() -> List[Path]:
    """This user's machine-local presence folder, as the hook names it: KABU_RUNTIME_DIR, XDG_RUNTIME_DIR, TMPDIR or
    /tmp, then kabu-presence-$USER; on a Mac also its per-user temp folder, which a harness may not pass as TMPDIR."""
    name = "kabu-presence-" + (os.environ.get("USER") or os.environ.get("LOGNAME") or "")
    base = os.environ.get("KABU_RUNTIME_DIR") or os.environ.get("XDG_RUNTIME_DIR") or os.environ.get("TMPDIR") or "/tmp"
    found = [Path(base.rstrip("/") or "/") / name]
    if sys.platform == "darwin" and not os.environ.get("KABU_RUNTIME_DIR"):
        try:
            mac = Path(os.confstr("CS_DARWIN_USER_TEMP_DIR") or "") / name
        except (ValueError, OSError):
            mac = found[0]
        found += [mac] if mac.is_absolute() and mac != found[0] else []
    return found


def runtime_dir() -> Path:
    return runtime_dirs()[0]


def own_dir(path: Path, create: bool = False) -> bool:
    """Whether path is a folder of this user's, never a link, made or set 0700: presence uses no other."""
    try:
        if create and not os.path.lexists(path):
            os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    except OSError:
        return False
    try:
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
            return False
        if st.st_mode & 0o077:
            os.chmod(path, 0o700)
    except OSError:
        return False
    return True


def presence_on() -> bool:
    """Presence is on unless KABU_PRESENCE=0 or `kabu presence off`."""
    return os.environ.get("KABU_PRESENCE") != "0" and not os.path.lexists(presence_dir() / "off")


def open_dir(path: Path) -> int:
    """A folder of this user's, opened never through a link: work done in it through this descriptor cannot be sent
    elsewhere by a link swapped in later."""
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    st = os.fstat(fd)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        os.close(fd)
        raise OSError(f"{path} is not a folder of this user's")
    return fd


def write_private(path: Path, value: Any, keep: bool = False) -> None:
    """Write JSON (or bytes) as a new 0600 file, never through a link, then put it in place at once: a rename replaces
    whatever the name was, a link or another file, without writing to it. keep: only if no file is there yet. All of it
    happens in the folder as opened once (open_dir), so a link swapped in for the folder meanwhile changes nothing."""
    folder = open_dir(path.parent)
    tmp = f".{path.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}"
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=folder)
        with os.fdopen(fd, "wb") as out:
            out.write(value if isinstance(value, bytes) else (json.dumps(value) + "\n").encode())
        try:
            if keep:
                os.link(tmp, path.name, src_dir_fd=folder, dst_dir_fd=folder, follow_symlinks=False)
            else:
                os.rename(tmp, path.name, src_dir_fd=folder, dst_dir_fd=folder)
        except FileExistsError:
            pass
    finally:
        try:
            os.unlink(tmp, dir_fd=folder)
        except OSError:
            pass
        os.close(folder)


def read_private(path: Path, limit: int = 1 << 16) -> Optional[bytes]:
    """A file of this user's, never through a link (the file's or its folder's), and only a regular one (never a FIFO
    that would block), or None."""
    try:
        folder = open_dir(path.parent)
    except OSError:
        return None
    try:
        fd = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=folder)
    except OSError:
        return None
    finally:
        os.close(folder)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_size > limit:
            return None
        return os.read(fd, limit)
    except OSError:
        return None
    finally:
        os.close(fd)


def read_json(path: Path) -> JSON:
    try:
        value = json.loads((read_private(path) or b"").decode("utf-8", "replace").split("\n", 1)[0])
    except ValueError:
        return {}
    return value if isinstance(value, dict) else {}


def machine_id() -> str:
    """This machine, which a home shared with others (NFS) does not share: KABU_MACHINE_ID, Linux's machine-id, the
    Mac's hardware UUID, else the host name. Only its hash names a file."""
    if os.environ.get("KABU_MACHINE_ID"):
        return os.environ["KABU_MACHINE_ID"]
    for name in ("/etc/machine-id", "/var/lib/dbus/machine-id"):
        try:
            text = Path(name).read_text().strip()
        except OSError:
            continue
        if text:
            return text
    if sys.platform == "darwin":
        try:
            import ctypes
            uid, wait = ctypes.create_string_buffer(16), (ctypes.c_long * 2)(0, 0)
            if ctypes.CDLL("/usr/lib/libSystem.B.dylib").gethostuuid(uid, wait) == 0:
                return uid.raw.hex()
        except (OSError, AttributeError, ValueError, ImportError):
            pass
    return socket.gethostname()


def installation(bump: bool = False) -> JSON:
    """This machine's reporter (ADR 021): its instance id and secret, made once and kept (mode 600), and its restart
    counter, which bump raises by one, in presence/reporter-<machine>.json (~/.kabu/installation.json is legacy
    kabu.py's): machines that share a home have their own. The secret never leaves the machine: it keys every HMAC."""
    if not (own_dir(kabu_home(), create=True) or os.path.isdir(kabu_home())) or not own_dir(presence_dir(), create=True):
        raise OSError(f"{presence_dir()} is not a folder of this user's (or is a link): presence uses none other")
    path = presence_dir() / f"reporter-{hashlib.sha256(machine_id().encode()).hexdigest()[:16]}.json"
    inst = read_json(path)
    if not (re.fullmatch(r"pin_[0-9A-Za-z]{8,40}", str(inst.get("instance"))) and re.fullmatch(r"[0-9a-f]{64}", str(inst.get("secret")))):
        fresh = {"instance": "pin_" + uuid.uuid4().hex[:24], "secret": os.urandom(32).hex(), "generation": 0}
        write_private(path, fresh, keep=not os.path.lexists(path))
        inst = read_json(path) or fresh
    inst["generation"] = int(inst.get("generation") or 0)
    if bump:
        inst["generation"] += 1
        write_private(path, inst)
    inst["path"] = str(path)
    return inst


def keyed(inst: JSON, *parts: str) -> str:
    """An id that names local things without showing them: HMAC(installation secret, parts), in hex."""
    return hmac.new(bytes.fromhex(str(inst["secret"])), "\0".join(parts).encode(), hashlib.sha256).hexdigest()


def proc_start(token: str) -> Optional[float]:
    """When a process started, as epoch seconds, from its start token (processes()): a Linux boot id and clock ticks,
    or ps's lstart in UTC. None when unknown."""
    try:
        if ":" in token and " " not in token:
            btime = next(float(line.split()[1]) for line in (PROC / "stat").read_text().splitlines() if line.startswith("btime "))
            return btime + int(token.rsplit(":", 1)[1]) / os.sysconf("SC_CLK_TCK")
        return float(calendar.timegm(time.strptime(token, "%a %b %d %H:%M:%S %Y"))) if token else None
    except (OSError, ValueError, StopIteration):
        return None


@dataclass
class Folded:
    """An agent session's records, folded: the latest event's state and the files that made it."""

    rec: JSON
    mtime: float
    files: List[Path]


def fold(folder: Path, pid: Optional[int] = None, now: Optional[float] = None) -> Dict[str, Folded]:
    """Each harness's records in folder, by lane (l<pid>), folded in seq order: the state is the latest event's, the
    session id the latest one given. A record still empty or unreadable is skipped; one PRESENCE_TORN old (a hook
    stopped mid-write) is removed when now is given."""
    lanes: Dict[str, List[Tuple[int, Path, Optional[JSON], float]]] = {}
    try:
        names = os.listdir(folder)
    except OSError:
        return {}
    for name in names:
        m = RECORD.fullmatch(name)
        if not m or pid is not None and int(m.group(1)) != pid:
            continue
        path = folder / name
        try:
            mtime = os.lstat(path).st_mtime
        except OSError:
            continue
        rec = record(path, int(m.group(1)))
        if rec is None and now is not None and now - mtime > PRESENCE_TORN:
            unlink(path)
            continue
        lanes.setdefault(f"l{m.group(1)}", []).append((int(m.group(2)), path, rec, mtime))
    out: Dict[str, Folded] = {}
    for lane, items in lanes.items():
        valid = sorted((i for i in items if i[2] is not None), key=lambda i: i[0])
        if not valid:
            continue
        rec = dict(valid[-1][2] or {})
        rec["sid"] = next((str(i[2]["sid"]) for i in reversed(valid) if i[2] and i[2].get("sid")), "")
        out[lane] = Folded(rec, valid[-1][3], [i[1] for i in items])
    return out


def record(path: Path, pid: int) -> Optional[JSON]:
    """One hook record, or None while it is being written or when it is not one."""
    rec = read_json(path)
    ok = rec.get("pid") == pid and isinstance(rec.get("seq"), int) and rec.get("runtime") in ("working", "idle", "offline") \
        and rec.get("attention") in (None, "terminal") and isinstance(rec.get("sid", ""), str)
    return rec if ok else None


def seq_of(path: Path) -> int:
    m = RECORD.fullmatch(path.name)
    return int(m.group(2)) if m else 0


def unlink(path: Path) -> None:
    try:
        os.unlink(path)
    except OSError:
        pass


def harness_slug(name: str) -> str:
    """The agent a harness's process name stands for: claude is claude-code; one kabu does not know, as a slug."""
    return AGENT_PROCESSES.get(name) or re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")[:64] or "agent"


def api_tag(api: Api) -> str:
    """Which API and key a kept session belongs to: one API's ids mean nothing to another's."""
    return hashlib.sha256(f"{api.base}\0{api.key}".encode()).hexdigest()[:16]


def lane_session(api: Api, inst: JSON, folder: Path, lane: str, rec: JSON, start: str, name: str,
                 timeout: float = 10.0) -> Optional[str]:
    """The Kabu session of an agent session: the one kept beside its records for this API, else get or create the
    session whose external_id is HMAC(installation secret, harness ‖ native session id), with no Live Activity. Its
    title is constant ('<harness> session'), and its project the one the harness's folder names, as kabu send's. The
    reporter and a kabu send in that agent session so find the same one. None when the API cannot say."""
    native = str(rec.get("sid") or "") or f"pid:{rec['pid']}:{start}"
    slug, path = harness_slug(name), folder / f"{lane}.session.json"
    base = keyed(inst, "session", slug, native)[:40]
    kept = read_json(path)
    turn = int(kept.get("round") or 0) if kept.get("id") == base else 0  # a session that ended: the next one
    if kept.get("api") == api_tag(api) and kept.get("id") == base and str(kept.get("session", "")).startswith("ses_") \
            and kept["session"] not in gone_sessions(api.base)[1]:
        return str(kept["session"])
    try:
        root = process_cwd(int(rec["pid"]))
        project = named_project(root.resolve())[0] if root else ""  # never a temp folder's, nor <folder>@<host>
    except OSError:
        project = ""
    body: JSON = {"title": f"{slug} session", "agent": slug, **({"project": project} if project else {})}
    for n in range(turn, turn + 3):
        try:
            got = Api(api.base, api.key, timeout, 0).call("POST", "/v2/sessions", {**body, "external_id": f"kp_{base}" + (f"-{n}" if n else "")},
                                                          idem=str(uuid.uuid4()))
        except CliError:
            return None
        if isinstance(got.get("id"), str) and got.get("status") not in ("ended", "expired") and not got.get("ended_at"):
            write_private(path, {"api": api_tag(api), "id": base, "round": n, "session": got["id"]})
            return str(got["id"])
    return None


def lane_ended(folder: Path, lane: str) -> None:
    """The API refused a lane's session (ended, or gone): the next one is a new session."""
    path = folder / f"{lane}.session.json"
    kept = read_json(path)
    if kept:
        write_private(path, {"api": kept.get("api"), "id": kept.get("id"), "round": int(kept.get("round") or 0) + 1})


def presence_join(api: Api) -> Tuple[Optional[str], Optional[Path], str]:
    """The session a kabu send or ask in an agent session that reports presence goes in (CONTRACT.md, Presence), with
    its folder and lane; None when presence is off, no hook wrote a record for this harness since it started, or the
    API cannot say."""
    agent = harness()
    if agent is None or not presence_on():
        return None, None, ""
    lane = f"l{agent[0]}"
    for folder in runtime_dirs():
        got = fold(folder, agent[0]).get(lane) if own_dir(folder) else None
        if got is None:
            continue
        started = proc_start(agent[1])
        if got.rec["runtime"] == "offline" or started is None or got.mtime < started - 1:
            return None, None, ""  # ended, or records left by an earlier process that had this id
        try:
            return lane_session(api, installation(), folder, lane, got.rec, agent[1], agent[2], timeout=3.0), folder, lane
        except (OSError, ValueError):
            return None, None, ""
    return None, None, ""


@dataclass
class Lane:
    """One agent session as the reporter sees it: its records, its harness's process, and what the API last took."""

    rec: JSON
    mtime: float
    start: str
    name: str
    checked: float
    session: Optional[str] = None
    sent: Optional[Tuple[str, Optional[str]]] = None  # the runtime and attention the API last took
    want: Optional[Tuple[str, Optional[str]]] = None  # what it should read, since `since`
    since: float = 0.0
    gone: float = 0.0  # when its harness exited or its session ended: offline once, then it is forgotten


class Reporter:
    """kabu presence run's state, one step() every PRESENCE_TICK: fold the records, check the harnesses, and send a
    batch when something changed or a beat is due. `clock` is the wall clock: records carry their file's mtime."""

    def __init__(self, connect: Callable[[], Optional[Api]], inst: JSON, folder: Path, clock: Callable[[], float] = time.time) -> None:
        self.connect, self.inst, self.folder, self.clock = connect, inst, folder, clock
        self.lanes: Dict[str, Lane] = {}
        self.seq = 0
        self.sent_at: List[float] = []  # when each batch of the last minute went
        self.next_beat = self.retry_at = 0.0
        self.failures = 0
        self.quiet_since = clock()
        self.status: JSON = {}

    def scan(self, now: float) -> None:
        """Fold every lane's records and keep only its latest. A new lane is adopted only while its harness runs, is no
        zombie, and started before its latest record was written: a record older than the process with its id is
        another process's, left behind."""
        seen = fold(self.folder, now=now)
        new = [key for key in seen if key not in self.lanes]
        info = processes([int(seen[key].rec["pid"]) for key in new]) if new else {}
        for key in new:
            first, proc = seen[key], info.get(int(seen[key].rec["pid"]))
            started = proc_start(proc.start) if proc else None
            if proc is None or proc.zombie or first.rec["runtime"] == "offline" or started is None or first.mtime < started - 1:
                self.forget(key, first.files)  # exited, ended or stale before anyone reported it: nothing to say
                continue
            self.lanes[key] = Lane(first.rec, first.mtime, proc.start, proc.name, checked=now)
        for key, lane in self.lanes.items():
            got = seen.get(key)
            if got is None:
                lane.gone = lane.gone or now  # its records were removed: offline
                continue
            for path in got.files:  # the latest stays, so the next hook's seq goes on from it
                if path.name != f"{key}-{got.rec['seq']}.json" and path.name.startswith(key + "-") and record(path, int(got.rec["pid"])):
                    unlink(path)
            if got.rec["seq"] != lane.rec["seq"] or got.mtime != lane.mtime:
                lane.rec, lane.mtime = got.rec, got.mtime
                if lane.gone and got.rec["runtime"] != "offline" and alive(int(got.rec["pid"])):
                    lane.gone = 0.0  # the session went on in the same process, as after Claude Code's /clear

    def check(self, now: float) -> None:
        """A harness whose process exited, is a zombie, or whose id another process took, or whose session ended,
        reads offline: kill -0 at every look, ps every PRESENCE_RECHECK."""
        due = {id(lane) for lane in self.lanes.values() if not lane.gone and now - lane.checked >= PRESENCE_RECHECK}
        info = processes([int(lane.rec["pid"]) for lane in self.lanes.values() if id(lane) in due]) if due else {}
        for lane in self.lanes.values():
            if lane.gone:
                continue
            dead = not alive(int(lane.rec["pid"])) or lane.rec["runtime"] == "offline"
            if id(lane) in due:
                lane.checked = now
                proc = info.get(int(lane.rec["pid"]))
                dead = dead or proc is None or proc.zombie or proc.start != lane.start
            lane.gone = now if dead else 0.0

    def value(self, lane: Lane, now: float) -> Optional[Tuple[str, Optional[str]]]:
        """What a lane reports in a batch now, or None: what it reads, but the last value taken while working and idle
        settle, and nothing for an exited session that was never reported or is reported offline already."""
        if lane.gone:
            return None if lane.sent in (None, ("offline", None)) else ("offline", None)
        runtime, attention = str(lane.rec["runtime"]), lane.rec.get("attention")
        if runtime == "working" and attention is None and lane.rec.get("event") != "tool" and now - lane.mtime > PRESENCE_DECAY:
            runtime = "idle"  # a turn the hooks lost the end of (an interrupt): no event for 15 minutes, no tool running
        want = (runtime, attention)
        if lane.want != want:
            lane.want, lane.since = want, now
        settling = lane.sent is not None and {lane.sent[0], runtime} == {"working", "idle"} and lane.sent[1] is None and attention is None
        return lane.sent if settling and now - lane.since < PRESENCE_SETTLE else want

    def step(self) -> bool:
        """One look and, when due, one batch. False once the reporter should exit: presence was turned off, or there
        was no agent session to report for PRESENCE_EXIT."""
        now = self.clock()
        on = presence_on() and own_dir(self.folder) and os.path.isdir(kabu_home())  # gone, as a test's folders go: exit
        self.scan(now)
        self.check(now)
        for lane in self.lanes.values():
            lane.gone = lane.gone or (0.0 if on else now)
        values = {key: self.value(lane, now) for key, lane in self.lanes.items()}
        changed = any(v is not None and v != self.lanes[key].sent for key, v in values.items())
        beat = any(v is not None for v in values.values()) and now >= self.next_beat
        self.sent_at = [t for t in self.sent_at if now - t < 60]
        if (changed or beat) and now >= self.retry_at and len(self.sent_at) < PRESENCE_PER_MINUTE:
            self.send(now, values)
        for key, lane in list(self.lanes.items()):
            if lane.gone and (lane.sent in (None, ("offline", None)) or now - lane.gone > PRESENCE_FORGET):
                pid, got = int(lane.rec["pid"]), fold(self.folder, int(lane.rec["pid"])).get(key)
                self.forget(key, [p for p in (got.files if got else []) if not alive(pid) or seq_of(p) <= lane.rec["seq"]])
        if self.lanes:
            self.quiet_since = now
        return on and now - self.quiet_since < PRESENCE_EXIT

    def forget(self, key: str, files: Iterable[Path]) -> None:
        """Drop a lane, the records it was folded from and its session; a record written since stays."""
        self.lanes.pop(key, None)
        for path in [*files, self.folder / f"{key}.session.json"]:
            unlink(path)

    def send(self, now: float, values: Dict[str, Optional[Tuple[str, Optional[str]]]]) -> None:
        """One batch: every live session of this machine (the API takes a session left out offline), at most 20."""
        api = self.connect()
        if api is None:
            self.status = {**self.status, "error": {"code": "missing_api_key", "at": iso(now)}}
            self.retry_at = now + PRESENCE_BEAT
            return
        reports: List[Tuple[str, Lane, Tuple[str, Optional[str]]]] = []
        for key, lane in sorted(self.lanes.items(), key=lambda kv: (not kv[1].gone, -kv[1].mtime)):
            value = values.get(key)
            if value is None:
                continue
            if lane.session is None and not lane.gone:
                lane.session = lane_session(api, self.inst, self.folder, key, lane.rec, lane.start, lane.name)
            if lane.session is not None and len(reports) < PRESENCE_REPORTS:
                reports.append((key, lane, value))
        if not reports:
            return
        self.seq += 1
        body = {"instance": self.inst["instance"], "generation": self.inst["generation"], "seq": self.seq,
                "reports": [{"session": lane.session, "lane": "ln_" + keyed(self.inst, "lane", key, lane.start)[:32],
                             "runtime": value[0], "attention": value[1], "source": "hook"} for key, lane, value in reports]}
        self.sent_at.append(now)
        beat: JSON = {"at": iso(now), "generation": body["generation"], "seq": self.seq, "reports": len(reports)}
        try:
            ack = Api(api.base, api.key, 10.0, 0).call("PUT", "/v2/presence", body)
        except CliError as e:
            self.failures += 1
            self.retry_at = now + min(PRESENCE_BEAT, 5.0 * 2 ** self.failures)
            self.status = {**self.status, "last_beat": {**beat, "error": {"code": e.code, "status": e.extra.get("status")}}}
            return
        self.failures, self.retry_at = 0, 0.0
        self.next_beat = now + max(1, int(ack.get("next_beat_in") or PRESENCE_BEAT))
        results = [r if isinstance(r, dict) else {} for r in ack.get("results") or []]
        for (key, lane, value), result in zip(reports, results):
            if result.get("reason") not in ("session_ended", "not_found", "stale"):
                lane.sent = value  # taken, or fenced by another reporter's lease: sent again at the next beat
            elif result.get("reason") != "stale":
                lane_ended(self.folder, key)
                lane.session, lane.sent = None, None
                if lane.gone:
                    lane.sent = ("offline", None)  # nothing left to take offline
        if any(r.get("reason") == "stale" for r in results):  # this counter was lost or reused: resume above the API's
            self.inst["generation"] = max(int(ack.get("generation") or 0), int(self.inst["generation"])) + 1
            self.seq = 0
            write_private(Path(self.inst["path"]), {k: v for k, v in self.inst.items() if k != "path"})
            self.retry_at = 0.0
            self.next_beat = now
        self.status = {"last_beat": beat, "ack": {k: ack.get(k) for k in ("server_time", "next_beat_in", "generation", "seq",
                                                                            "expires_at", "results")}}


def alive(pid: int) -> bool:
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except OSError:
        pass  # another user's process
    return True


def iso(at: float) -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(at))


def presence_run(a: JSON) -> int:
    """The machine's one reporter: exits at once when another holds the lock, presence is off, its folder is not this
    user's own (or is a link) or this is no POSIX system; else reports until presence is turned off or no agent session
    was left for 10 minutes."""
    folder = runtime_dir()
    if not presence_on() or not own_dir(folder, create=True):
        return EXIT_OK
    try:
        import fcntl
    except ImportError:
        return EXIT_OK
    try:
        fd = os.open(folder / "run.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    except OSError:
        return EXIT_OK  # a link, or not ours to open
    with os.fdopen(fd, "r+b") as lock:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
            return EXIT_OK
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            return EXIT_OK  # another reporter runs on this machine
        try:
            os.setsid()  # outlives the hook that started it
        except OSError:
            pass
        write_private(folder / "run.pid", f"{os.getpid()}\n".encode())

        def connect() -> Optional[Api]:
            try:
                return Api.connect(a)  # the key and base URL again each time: kabu login may come later
            except CliError:
                return None

        try:
            inst = installation(bump=True)
        except OSError:
            return EXIT_OK
        reporter, shown = Reporter(connect, inst, folder), None
        try:
            while reporter.step():
                if reporter.status != shown:  # written when it changes, not every tick
                    write_private(folder / "status.json", reporter.status)
                    shown = dict(reporter.status)
                time.sleep(PRESENCE_TICK)
            write_private(folder / "status.json", reporter.status)
        finally:
            if (read_private(folder / "run.pid") or b"").strip() == str(os.getpid()).encode():
                unlink(folder / "run.pid")
        del lock
    return EXIT_OK


def presence_status() -> JSON:
    """What kabu presence status prints: the switch, the reporter, each agent session's state and the last batch."""
    folder = runtime_dir()
    lanes = []
    for key, got in sorted(fold(folder).items()) if own_dir(folder) else ():
        lanes.append({"lane": key, "runtime": got.rec["runtime"], "attention": got.rec.get("attention"), "event": got.rec.get("event"),
                      "seq": got.rec["seq"], "pid": got.rec["pid"], "alive": alive(int(got.rec["pid"])), "updated_at": iso(got.mtime),
                      "session": read_json(folder / f"{key}.session.json").get("session")})
    run = read_json(folder / "status.json")
    try:
        pid = int((read_private(folder / "run.pid") or b"").strip() or 0)
    except ValueError:
        pid = 0
    try:
        inst = {k: v for k, v in installation().items() if k in ("instance", "generation")}
    except OSError:
        inst = {}
    return {"ok": True, "enabled": presence_on(), "off": os.path.lexists(presence_dir() / "off"),
            "opted_out": os.environ.get("KABU_PRESENCE") == "0", "running": pid > 1 and alive(pid), "pid": pid if pid > 1 and alive(pid) else None,
            "instance": inst.get("instance"), "generation": inst.get("generation"), "dir": str(folder), "lanes": lanes,
            "last_beat": run.get("last_beat"), "ack": run.get("ack")}


def settings_file(harness_name: str, given_path: Optional[str]) -> Path:
    """A harness's user settings: Claude Code's CLAUDE_CONFIG_DIR (~/.claude), Copilot CLI's COPILOT_HOME (~/.copilot)."""
    if given_path:
        return Path(os.path.expanduser(given_path))
    home = os.environ.get("CLAUDE_CONFIG_DIR" if harness_name == "claude" else "COPILOT_HOME")
    return Path(home or Path.home() / (".claude" if harness_name == "claude" else ".copilot")) / "settings.json"


def hook_entries(harness_name: str, hook: Path) -> Dict[str, JSON]:
    """The hook's entry for each event, under the harness's own name for it: Claude Code's matcher groups, or Copilot
    CLI's native keys (sessionStart, userPromptSubmitted, …, agentStop) with flat {type, bash, timeoutSec} entries."""
    entries: Dict[str, JSON] = {}
    for event in HOOK_EVENTS:
        name = COPILOT_EVENTS[event] if harness_name == "copilot" else event
        command = f"kabu_event={name}; [ ! -r {shlex.quote(str(hook))} ] || (. {shlex.quote(str(hook))}) || true"
        entries[name] = {"type": "command", "bash": command, "timeoutSec": 5} if harness_name == "copilot" else \
            {**({"matcher": NEEDS_INPUT} if event == "Notification" else {}), "hooks": [{"type": "command", "command": command, "timeout": 5}]}
    return entries


def ours(entry: Any) -> bool:
    """An entry kabu presence install wrote: its command runs the installed hook."""
    return HOOK_FILE in json.dumps(entry)


def digest(raw: bytes) -> str:
    return hashlib.sha256(raw).hexdigest()


def backup(path: Path, raw: bytes) -> Path:
    """A new 0600 copy of a settings file's bytes, beside it, under a name no other backup has."""
    name = path.with_name(f"{path.name}.bak-kabu-presence-{time.strftime('%Y%m%d-%H%M%S')}-{time.time_ns() % 10**9:09d}-{uuid.uuid4().hex[:6]}")
    fd = os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as out:
        out.write(raw)
    return name


def put_settings(path: Path, raw: bytes, mode: int) -> None:
    """Replace the settings file at once (temp and rename, beside the file a link names), never looser than 0600."""
    real = path.resolve()
    tmp = real.with_name(f".{real.name}.{os.getpid()}.{uuid.uuid4().hex[:8]}")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as out:
        out.write(raw)
    os.chmod(tmp, mode & 0o600)
    os.replace(tmp, real)


def presence_install(a: JSON, install: bool) -> JSON:
    """Add the presence hook to a harness's settings, or take it out, after a backup. Install is idempotent; uninstall
    puts back the exact bytes from before the install when the file is as kabu left it, else takes out only kabu's
    entries. The hook file goes once no settings use it (presence/installs.json keeps what was installed where)."""
    path, hook, manifest_path = settings_file(a["harness"], a["settings"]), kabu_home() / HOOK_FILE, presence_dir() / "installs.json"
    if not (os.path.isdir(kabu_home()) or own_dir(kabu_home(), create=True)) or not own_dir(presence_dir(), create=True):
        raise CliError("unsafe_folder", f"{presence_dir()} is not a folder of this user's, or is a link.", "Remove it, then run this again.")
    try:
        raw: Optional[bytes] = path.read_bytes()
        mode = path.stat().st_mode & 0o777
    except FileNotFoundError:
        raw, mode = None, 0o600
    try:
        settings = json.loads(raw) if raw and raw.strip() else {}
    except ValueError as exc:
        raise CliError("invalid_settings", f"{path} is not JSON ({exc}), so kabu left it as it is.", "Fix the file, then run this again.") from None
    if not isinstance(settings, dict) or not isinstance(settings.get("hooks", {}), dict):
        raise CliError("invalid_settings", f"{path} has no hooks object kabu can add to.", "Fix the file, then run this again.")
    manifest = read_json(manifest_path)
    key, entry = str(path.resolve()), manifest.get(str(path.resolve())) or {}
    hooks: JSON = {}
    for event, entries in settings.get("hooks", {}).items():
        kept = [e for e in entries if not ours(e)] if isinstance(entries, list) else entries
        if kept != []:
            hooks[event] = kept
    saved: List[str] = []
    if install:
        write_private(hook, PRESENCE_HOOK.replace(HOOK_CLI, f"kabu_cli={shlex.quote(os.path.abspath(__file__))}", 1).encode())
        for event, added in hook_entries(a["harness"], hook).items():
            hooks[event] = [*(hooks.get(event) or []), added]
        updated = {**settings, "hooks": hooks}
        new = (json.dumps(updated, indent=2, ensure_ascii=False) + "\n").encode()
        changed = updated != settings
        if changed:
            saved += [str(backup(path, raw))] if raw is not None else []
            put_settings(path, new, mode)
            manifest[key] = {"harness": a["harness"], "before": entry.get("before", digest(raw) if raw is not None else None),
                             "backup": entry.get("backup", saved[0] if saved else None), "after": digest(new)}
    else:
        changed = raw is not None and (key in manifest or any(ours(e) for v in settings.get("hooks", {}).values() for e in (v if isinstance(v, list) else [])))
        if changed and raw is not None:
            saved.append(str(backup(path, raw)))
            first = read_private(Path(entry["backup"]), 1 << 26) if entry.get("backup") else None
            if entry and digest(raw) == entry.get("after") and entry.get("before") is None:
                path.unlink()  # kabu made the file: as kabu left it, it goes
            elif entry and digest(raw) == entry.get("after") and first is not None and digest(first) == entry.get("before"):
                put_settings(path, first, mode)  # as kabu left it: the bytes from before, exactly
            else:  # edited since: only kabu's entries go
                updated = {**settings, "hooks": hooks}
                if not hooks and "hooks" not in json.loads(first or b"{}"):
                    updated.pop("hooks")
                put_settings(path, (json.dumps(updated, indent=2, ensure_ascii=False) + "\n").encode(), mode)
        manifest.pop(key, None)
        if not manifest:
            unlink(hook)
    write_private(manifest_path, manifest)
    return {"ok": True, "harness": a["harness"], "settings": str(path), "hook": str(hook), "installed": install,
            "events": list(hook_entries(a["harness"], hook)) if install else [], "changed": changed,
            "backup": saved[0] if saved else None}


def cmd_presence(cmd: str, a: JSON) -> int:
    """presence run, status, on, off, install and uninstall (CONTRACT.md, Presence)."""
    action = cmd.split()[1]
    check(cmd, COMMANDS[cmd].opts, a)
    if action == "run":
        return presence_run(a)
    if action in ("on", "off"):
        if not (os.path.isdir(kabu_home()) or own_dir(kabu_home(), create=True)) or not own_dir(presence_dir(), create=True):
            raise CliError("unsafe_folder", f"{presence_dir()} is not a folder of this user's, or is a link.", "Remove it, then run this again.")
        if action == "off":
            write_private(presence_dir() / "off", {"off": True})
        else:
            unlink(presence_dir() / "off")
    if action in ("install", "uninstall"):
        if not a["harness"]:
            raise CliError("missing_flag", f"kabu presence {action} needs --harness claude or copilot.",
                           f"Example: kabu presence {action} --harness claude")
        return emit(presence_install(a, action == "install"))
    return emit(presence_status())


@dataclass(frozen=True)
class Command:
    handler: Callable[[str, JSON], int]
    about: str
    examples: str
    opts: Tuple[Opt, ...]
    positional: Tuple[str, ...] = ()  # name, nargs, help


COMMANDS = {
    "send": Command(cmd_message, "Notify a human. Prints {ok, id, status, attachments}.", """\
  kabu send "Tests passed" "412 passed, 0 failed" --file report.png --link "PR=https://github.com/o/r/pull/7"
  kabu send "Nightly report" - < report.md
  git diff | kabu send "Review this" --diff - --diff-path src/app.py""", MESSAGE, TEXT_ARG),
    "ask": Command(cmd_message, "Ask a human and wait. Exit 0 approved or a choice or text given; 10 rejected; 20 expired; "
                   "21 cancelled or deleted.", """\
  kabu ask "Deploy to prod?"                  approve (exit 0) or reject (exit 10)
  kabu ask "Which env?" -c staging -c prod    a choice: exit 0 whatever is chosen, so branch on .option
  kabu ask "Release name?" --type text        the answer's text is what they typed
  kabu ask "Run it?" --action db.migrate --args '{"version": 42}' --irreversible""", MESSAGE, TEXT_ARG),
    "status": Command(cmd_status, "Print a message as the API has it; exit 0 whatever the answer, so read .resolution.decision.", """\
  kabu status msg_01J9Z --wait 50     hold up to 50 s while an ask is pending""", STATUS, ("id", "?", "a msg_… id")),
    "whoami": Command(cmd_whoami, "Print what the key can do, its org, and the project (and why) and agent kabu would send.", """\
  kabu whoami""", CONNECTION),
    "session start": Command(cmd_session, "Get or create a running session with a Live Activity. Prints the session.", """\
  export KABU_SESSION=$(kabu session start --title "Fix flaky auth test" | jq -r .id)
  kabu session start --title "Nightly build" --external-id run-77 --headline "Compiling" --progress 1/4""",
                             SESSION_CREATE + SESSION_UPDATE + CONNECTION),
    "session update": Command(cmd_session, "Update a session's Live Activity. Prints the session.", """\
  kabu session update --headline "Deleting projects" --progress 54/172 --progress-label projects

{G}""".replace("{G}", PROGRESS_RULE), SESSION_UPDATE + CONNECTION, SESSION_ID),
    "session end": Command(cmd_session, "End a session; its pending asks are cancelled. Prints the session.", """\
  kabu session end --outcome success --summary "PR opened"
  kabu session end ses_01J9Z --outcome failure --dismiss-after 0""", SESSION_END, SESSION_ID),
    "login": Command(cmd_login, "Save a key and defaults to the config file (mode 600). Exit 10: code denied; 20: expired.", """\
  kabu login --device                   prints a code to enter in the Kabu app, then saves this computer's key
  kabu login --api-key - < key.txt      no prompt; with no flag at a terminal, kabu asks for the key""", LOGIN),
    "mcp": Command(cmd_mcp, "Serve Kabu's MCP tools on stdin and stdout for a harness that starts it, through the API's /mcp "
                   "and the saved key. Exit 0 when stdin closes.", """\
  claude mcp add kabu -- kabu mcp       Claude Code; the kabu plugin adds it for you
  copilot mcp add kabu -- kabu mcp      GitHub Copilot CLI
  echo '{"jsonrpc": "2.0", "id": 1, "method": "tools/list"}' | kabu mcp""", CONNECTION),
    "presence status": Command(cmd_presence, "Print whether presence is on, the reporter, each agent session's record on this "
                               "machine and the last batch the API took.", """\
  kabu presence status | jq '.lanes[] | {runtime, session}'""", ()),
    "presence on": Command(cmd_presence, "Turn presence on again on this machine (it is on by default). Prints the status.", """\
  kabu presence on""", ()),
    "presence off": Command(cmd_presence, "Turn presence off on this machine: the hooks write nothing, the reporter takes its "
                            "sessions offline and exits, and kabu send joins no presence session. Prints the status.", """\
  kabu presence off                     KABU_PRESENCE=0 does the same for one agent's environment""", ()),
    "presence run": Command(cmd_presence, "Report this machine's agent sessions to Kabu until none is left for 10 minutes. The "
                            "hook starts it; a second one exits at once.", """\
  kabu presence run &""", CONNECTION),
    "presence install": Command(cmd_presence, "Add the presence hook to a harness's settings, after a backup; running it again "
                                "changes nothing. Not needed with the Kabu plugin, which has the hook.", """\
  kabu presence install --harness claude
  kabu presence install --harness copilot --settings ~/.copilot-work/settings.json""", PRESENCE_SETTINGS),
    "presence uninstall": Command(cmd_presence, "Take the presence hook out of a harness's settings, after a backup.", """\
  kabu presence uninstall --harness claude""", PRESENCE_SETTINGS),
}


def run(args: List[str]) -> int:
    """A command, its help, the version or the guide; with no command, kabu.py's form."""
    if not args:
        raise CliError("missing_command", "kabu needs a command or a message.", 'Run: kabu --help, or: kabu send "Build passed"')
    head = args[0]
    if head in ("-h", "--help") or args[:2] in (["session", "--help"], ["presence", "--help"]):
        print(__doc__)
        return EXIT_OK
    if head == "--version":
        print(f"kabu {VERSION}")
        return EXIT_OK
    if head == "guide" or args[:2] == ["help", "agents"]:  # the rules, then every command's examples
        print(__doc__ + GUIDE + "".join(f"\n\nkabu {name}: {c.about}\n{c.examples}" for name, c in COMMANDS.items()))
        return EXIT_OK
    if head == "help":
        if args[1:] and args[1] not in NAMES:
            raise CliError("unknown_command", f"kabu has no {args[1]!r} command.", "Run: kabu --help")
        return run(args[1:] + ["--help"])
    name = " ".join(args[:2]) if head in ("session", "presence") else head
    if name in COMMANDS:
        return COMMANDS[name].handler(name, parse(name, args[len(name.split()):]))
    if head in ("session", "presence"):
        subs = [n.split()[1] for n in COMMANDS if n.startswith(head + " ")]
        close = difflib.get_close_matches(" ".join(args[1:2]), subs, n=1)
        raise CliError("unknown_command", f"kabu {head} takes {', '.join(subs[:-1])} or {subs[-1]}, not {' '.join(args[1:2])!r}."
                       + (f" Did you mean {close[0]!r}?" if close else ""), f"Example: kabu {head} {SUBCOMMAND_SAMPLES[head]}")
    if head in LEGACY:  # never a message: a steering LaunchAgent may still run `kabu.py daemon`
        raise CliError("unknown_command", f"kabu has no {head!r} command: kabu.py's steering ({', '.join(LEGACY[:5])}) and project "
                       "settings are not in kabu.", f"Use the legacy kabu.py 0.2.0 for it. To send the word itself: kabu send {head}")
    close = difflib.get_close_matches(head, NAMES, n=1, cutoff=0.75) if head.isalpha() else []
    if close:
        raise CliError("unknown_command", f"kabu has no {head!r} command. Did you mean {close[0]!r}?",
                       f"Run: kabu {close[0]} --help (to send the word itself: kabu send {head})")
    cmd = "ask" if {arg.split("=", 1)[0] for arg in args} & {"--ask", "--ask-text"} else "send"
    a = parse(cmd, args)
    if a["ask"] and not a["type"] and not a["allow_reply"] and tuple(c.strip().lower() for c in a["choice"]) in YES_NO:
        a["type"] = "confirm"  # the first approves (exit 0), the second rejects (exit 10); any other pair stays a choice
    return cmd_message(cmd, a)


def main(argv: Optional[Sequence[str]] = None) -> int:
    try:
        return run(list(sys.argv[1:] if argv is None else argv))
    except CliError as e:
        error = e
    except (OSError, ValueError, RuntimeError) as exc:  # a local failure kabu could not foresee, such as an unwritable config
        error = CliError("local_error", f"{type(exc).__name__}: {exc}.", "Check the file, permission or setting it names.")
    except SystemExit as e:  # argparse after --help
        return e.code if isinstance(e.code, int) else EXIT_OK
    except KeyboardInterrupt:
        return 130
    print(error_line(error), file=sys.stderr)
    return error.exit


if __name__ == "__main__":
    raise SystemExit(main())
